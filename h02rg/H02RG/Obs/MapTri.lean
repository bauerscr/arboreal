import Obs.MapDef

/-!
# Upper-triangular structure of the observable map: the `a` component

`killO : OE c Λ →ₐ[ℂ] OE c Λ`, `F ↦ F_∅ + σ_a F_a` (the quotient by the ideal generated by
`σ̄_b`, resp. `σ_b`) is an algebra homomorphism commuting with `θ`, `ι`, `𝔼_C`.  Hence
(`map_KnextG`) `(π_∅ + π_a) K_{j+1}` only depends on `(π_∅ + π_a)` of the ingredients, and
these only depend on `π_∅ V_j`, the `a` coupling constants of `V_j` (`λ_a`) and
`(π_∅ + π_a) K_j` (`killO_KnextO`): the `a` component `π_a Φ_{j+1}(V_j, K_j)` does not depend on
`(V^b_j, K^b_j)` or `(V^{ab}_j, K^{ab}_j)`.  The `b` component is symmetric (not formalised).
-/

namespace Obs

noncomputable section

open Finset Grassmann SA Loc Step LocObs Gen

section Kill

variable {c : Case} {Λ : Type*} [DecidableEq Λ]

/-- `F ↦ F_∅ + σ_a F_a`. -/
def killS : SA c Λ →ₐ[ℂ] SA c Λ where
  toFun F := ⟨F.e, F.a, 0, 0⟩
  map_one' := by ext <;> simp
  map_mul' F G := by ext <;> simp
  map_zero' := by ext <;> simp
  map_add' F G := by ext <;> simp
  commutes' r := by ext <;> simp

@[simp] theorem killS_e (F : SA c Λ) : (killS F).e = F.e := rfl
@[simp] theorem killS_a (F : SA c Λ) : (killS F).a = F.a := rfl
@[simp] theorem killS_b (F : SA c Λ) : (killS F).b = 0 := rfl
@[simp] theorem killS_ab (F : SA c Λ) : (killS F).ab = 0 := rfl

/-- `F ↦ F_∅ + σ_a F_a` on even elements. -/
def killO : OE c Λ →ₐ[ℂ] OE c Λ :=
  ((killS : SA c Λ →ₐ[ℂ] SA c Λ).comp (OEv c Λ).val).codRestrict (OEv c Λ) fun F => by
    obtain ⟨h1, h2, -, -⟩ := mem_OEv.1 F.2
    exact mem_OEv.2 ⟨h1, h2, by simp, by simp⟩

@[simp] theorem coe_killO (F : OE c Λ) : (killO F : SA c Λ) = killS (F : SA c Λ) := rfl

theorem killO_ext {F G : OE c Λ} (he : (F : SA c Λ).e = (G : SA c Λ).e)
    (ha : (F : SA c Λ).a = (G : SA c Λ).a) : killO F = killO G :=
  Subtype.ext (SA.ext he ha rfl rfl)

theorem killO_thetaO (F : OE c Λ) : killO (thetaO F) = thetaO (killO F) :=
  Subtype.ext (SA.ext rfl rfl (by simp) (by simp))

theorem killO_inclO (F : OE c Λ) : killO (inclO F) = inclO (killO F) :=
  Subtype.ext (SA.ext rfl rfl (by simp) (by simp))

theorem killO_ECO [Fintype Λ] (C : Matrix Λ Λ ℝ) (F : OE c (Λ ⊕ Λ)) :
    killO (ECO C F) = ECO C (killO F) :=
  Subtype.ext (SA.ext rfl rfl (by simp) (by simp))

theorem bulk_killO (F : OE c Λ) : bulk (killO F) = bulk F := rfl

end Kill

variable {d L N : ℕ} [NeZero L]

theorem RGIngr.map_congr {R S : Type*} (φ : R → S) {F G : RGIngr d L N R}
    (h1 : ∀ p, φ (F.I0 p) = φ (G.I0 p)) (h2 : ∀ p, φ (F.eV p) = φ (G.eV p))
    (h3 : ∀ p, φ (F.eu p) = φ (G.eu p)) (h4 : ∀ p, φ (F.eum p) = φ (G.eum p))
    (h5 : ∀ p X, φ (F.J p X) = φ (G.J p X)) (h6 : ∀ X, φ (F.K X) = φ (G.K X)) :
    F.map φ = G.map φ := by
  simp only [RGIngr.map, h1, h2, h3, h4, h5, h6]

section Tri

variable {c : Case}

/-- The `a` coupling constant `λ_a`. -/
def laOf : (c : Case) → Coup c → ℂ
  | .one, V => Coup1.la V
  | .two, V => Coup2.la V

theorem killO_halfBO (W : Coup c) (a b : Lam d L N) : killO (halfBO c W a b) = 0 := by
  cases c <;> exact Subtype.ext (by ext <;> simp [halfB])

theorem killO_splitO (W : Coup c) (a b : Lam d L N) (X : Finset (Lam d L N)) :
    killO (splitO c W a b X) = ind (a ∈ X) • killO (halfAO c W a b) := by
  rw [splitO, map_add, map_smul, map_smul, killO_halfBO, smul_zero, add_zero]

theorem halfA_e (c : Case) (W : Coup c) (a b : Lam d L N) : (halfA c W a b).e = 0 := by
  cases c <;> rfl

theorem killO_oexp {F : OE c (Lam d L N)} (hn : IsNilpotent F) : killO (oexp F) = oexp (killO F) :=
  IsNilpotent.map_exp hn killO

variable {j : ℕ} {C : Matrix (Lam d L N) (Lam d L N) ℝ} {Vb : Vcoup} {Vo Vo' : Coup c}
  {K K' : Finset (Lam d L N) → OE c (Lam d L N)} {a b : Lam d L N}

theorem a_eq_of_killO (hK : ∀ X, killO (K X) = killO (K' X)) (X : Finset (Lam d L N)) :
    (K X : SA c (Lam d L N)).a = (K' X : SA c (Lam d L N)).a := by
  have := congrArg (fun F : OE c (Lam d L N) => (F : SA c (Lam d L N)).a) (hK X)
  simpa using this

theorem bulkK_eq_of_killO (hK : ∀ X, killO (K X) = killO (K' X)) : bulkK K = bulkK K' :=
  funext fun X => by rw [bulkK, bulkK, ← bulk_killO, hK X, bulk_killO]

end Tri

end

end Obs
