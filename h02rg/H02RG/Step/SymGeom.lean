import Step.Defs

/-!
# Lattice automorphisms, blocks and polymers

The automorphisms generated by translations, reflections and coordinate permutations
(`IsGen`) are the maps `x ↦ g x + t` with `g` a signed permutation of the coordinates
(`IsGen.exists_form`).  They are isometries for `|·|_∞`, and, if they map `(j+1)`-blocks to
`(j+1)`-blocks, they also map `j`-blocks to `j`-blocks (`PresBlocks.of_succ`).  Block-preserving
automorphisms map polymers, connected polymers, small sets, closures, components and small set
neighbourhoods to the corresponding objects, and `V(E X) = E V(X)` (`IsGen.eval_img`).
-/

namespace Step

noncomputable section

open Finset Grassmann Loc FRD

variable {d L N : ℕ} [NeZero L]

/-! ### One-dimensional block arithmetic -/

section OneDim

variable {n : ℕ} [NeZero n]

/-- `f : ℤ/nℤ → ℤ/nℤ` maps `k`-intervals into `k`-intervals. -/
def PresK (k : ℕ) (f : ZMod n → ZMod n) : Prop :=
  ∀ v w : ZMod n, v.val / k = w.val / k → (f v).val / k = (f w).val / k

theorem pos_of_dvd_ne {k : ℕ} (hk : k ∣ n) : 0 < k :=
  Nat.pos_of_ne_zero fun h => by subst h; exact NeZero.ne n (Nat.eq_zero_of_zero_dvd hk)

theorem dvd_val_natCast {k a : ℕ} (hk : k ∣ n) (ha : k ∣ a) : k ∣ ((a : ZMod n)).val := by
  rw [ZMod.val_natCast]; exact (Nat.dvd_mod_iff hk).2 ha

theorem dvd_val_add {k : ℕ} (hk : k ∣ n) {a b : ZMod n} (ha : k ∣ a.val) (hb : k ∣ b.val) :
    k ∣ (a + b).val := by
  rw [ZMod.val_add]; exact (Nat.dvd_mod_iff hk).2 (dvd_add ha hb)

theorem dvd_val_neg {k : ℕ} (hk : k ∣ n) {a : ZMod n} (ha : k ∣ a.val) : k ∣ (-a).val := by
  rw [ZMod.neg_val]; split_ifs
  · exact dvd_zero _
  · exact Nat.dvd_sub hk ha

theorem nat_add_mod_div {k a b : ℕ} (hk : k ∣ n) (hk0 : 0 < k) (hb : k ∣ b) :
    (a + b) % n / k = (a / k + b / k) % (n / k) := by
  obtain ⟨M, hM⟩ := hk
  obtain ⟨c, rfl⟩ := hb
  rw [hM, Nat.mod_mul_right_div_self, Nat.mul_div_cancel_left _ hk0,
    Nat.mul_div_cancel_left _ hk0, Nat.add_mul_div_left _ _ hk0]

theorem presK_add {k : ℕ} (hk : k ∣ n) {c : ZMod n} (hc : k ∣ c.val) : PresK k (· + c) := by
  intro v w h
  simp only
  rw [ZMod.val_add, ZMod.val_add, nat_add_mod_div hk (pos_of_dvd_ne hk) hc,
    nat_add_mod_div hk (pos_of_dvd_ne hk) hc, h]

theorem val_neg_sub_one (v : ZMod n) : (-v - 1).val = n - 1 - v.val := by
  have hv := ZMod.val_lt v
  have : (-v - 1 : ZMod n) = ((n - 1 - v.val : ℕ) : ZMod n) := by
    rw [Nat.cast_sub (by omega), Nat.cast_sub (by omega), ZMod.natCast_self,
      ZMod.natCast_zmod_val, Nat.cast_one]; ring
  rw [this, ZMod.val_natCast_of_lt (by omega)]

theorem nat_sub_div {k a : ℕ} (hk : k ∣ n) (hk0 : 0 < k) (ha : a < n) :
    (n - 1 - a) / k = n / k - 1 - a / k := by
  obtain ⟨M, hM⟩ := hk
  rw [hM] at ha ⊢
  rw [Nat.mul_div_cancel_left _ hk0]
  have h1 := Nat.div_add_mod a k
  have h2 := Nat.mod_lt a hk0
  set q := a / k
  set r := a % k
  have hq : q < M := by
    by_contra h; push Not at h
    have : k * M ≤ k * q := Nat.mul_le_mul_left _ h
    omega
  obtain ⟨M', rfl⟩ : ∃ M', M = q + 1 + M' := ⟨M - q - 1, by omega⟩
  have e : k * (q + 1 + M') - 1 - a = (k - 1 - r) + k * M' := by
    have : k * (q + 1 + M') = k * q + k + k * M' := by ring
    rw [this]
    generalize k * q = A at *
    generalize k * M' = B
    omega
  rw [e, Nat.add_mul_div_left _ _ hk0, Nat.div_eq_of_lt (by omega)]
  omega

theorem presK_negsub {k : ℕ} (hk : k ∣ n) : PresK k (fun v : ZMod n => -v - 1) := by
  intro v w h
  simp only
  rw [val_neg_sub_one, val_neg_sub_one, nat_sub_div hk (pos_of_dvd_ne hk) (ZMod.val_lt v),
    nat_sub_div hk (pos_of_dvd_ne hk) (ZMod.val_lt w), h]

theorem presK_neg_add {k : ℕ} (hk : k ∣ n) {c : ZMod n} (hc : k ∣ (c + 1).val) :
    PresK k (fun v => -v + c) := by
  have e : ∀ v : ZMod n, -v + c = (-v - 1) + (c + 1) := fun v => by ring
  intro v w h
  simp only [e]
  exact presK_add hk hc _ _ (presK_negsub hk _ _ h)

theorem dvd_of_presK {m : ℕ} (hm : m ∣ n) (hmn : m < n) {c : ZMod n} (h : PresK m (· + c)) :
    m ∣ c.val := by
  have hm0 := pos_of_dvd_ne hm
  obtain ⟨M, hM⟩ := hm
  by_contra hr
  have hr0 : 0 < c.val % m := Nat.pos_of_ne_zero fun h0 => hr (Nat.dvd_of_mod_eq_zero h0)
  have hrm : c.val % m < m := Nat.mod_lt _ hm0
  have hw : ((m - c.val % m : ℕ) : ZMod n).val = m - c.val % m :=
    ZMod.val_natCast_of_lt (by omega)
  have := h 0 ((m - c.val % m : ℕ) : ZMod n)
    (by rw [hw, ZMod.val_zero, Nat.zero_div, Nat.div_eq_of_lt (by omega)])
  simp only [zero_add] at this
  rw [ZMod.val_add, hw] at this
  have h1 := Nat.div_add_mod c.val m
  have hc := ZMod.val_lt c
  set q := c.val / m
  set r := c.val % m
  have e : m - r + c.val = m * (q + 1) := by
    rw [mul_add, mul_one]
    generalize m * q = A at *
    omega
  have e2 : m * (q + 1) % n / m = (q + 1) % M := by
    rw [hM, Nat.mod_mul_right_div_self, Nat.mul_div_cancel_left _ hm0]
  rw [e, e2] at this
  have hM1 : 1 < M := by
    by_contra h; push Not at h
    interval_cases M <;> omega
  have hqM : q < M := by
    by_contra h; push Not at h
    have : m * M ≤ m * q := Nat.mul_le_mul_left _ h
    omega
  rcases Nat.lt_or_ge (q + 1) M with h3 | h3
  · rw [Nat.mod_eq_of_lt h3] at this; omega
  · have hq1 : q + 1 = M := by omega
    rw [hq1, Nat.mod_self] at this
    omega

theorem card_filter_div {k c : ℕ} (hk0 : 0 < k) (hc : c * k + k ≤ n) :
    (univ.filter fun v : ZMod n => v.val / k = c).card = k := by
  suffices hs : (range k).card = (univ.filter fun v : ZMod n => v.val / k = c).card by
    rw [← hs, card_range]
  refine Finset.card_nbij' (fun r => ((c * k + r : ℕ) : ZMod n)) (fun v => v.val - c * k)
    ?_ ?_ ?_ ?_
  · intro r hr
    simp only [coe_range, Set.mem_Iio] at hr
    simp only [coe_filter, mem_univ, true_and, Set.mem_setOf_eq]
    rw [ZMod.val_natCast_of_lt (by omega)]
    exact div_eq_of_bounds hk0 (by omega) (by omega)
  · intro v hv
    simp only [coe_filter, mem_univ, true_and, Set.mem_setOf_eq] at hv
    simp only [coe_range, Set.mem_Iio]
    have h1 := Nat.div_mul_le_self v.val k
    have h2 := Nat.lt_div_mul_add (a := v.val) hk0
    rw [hv] at h1 h2
    omega
  · intro r hr
    simp only [coe_range, Set.mem_Iio] at hr
    simp only
    rw [ZMod.val_natCast_of_lt (by omega)]
    omega
  · intro v hv
    simp only [coe_filter, mem_univ, true_and, Set.mem_setOf_eq] at hv
    have h1 := Nat.div_mul_le_self v.val k
    rw [hv] at h1
    simp only
    rw [Nat.add_sub_cancel' h1, ZMod.natCast_zmod_val]

end OneDim

/-! ### Normal form and isometry -/

theorem IsGen.exists_form {T : AffAut d L N} (hT : IsGen T) :
    ∃ (π : Equiv.Perm (Fin d)) (s : Fin d → ℤˣ) (t : Lam d L N), ∀ x, T.E x =
      (show Lam d L N from fun i => ((s i : ℤ) : ZMod (L ^ N)) * co x (π i)) + t := by
  induction hT with
  | transl t =>
    refine ⟨1, 1, t, fun x => ?_⟩
    show x + t = _
    congr 1; funext i; simp [co]
  | refl i =>
    refine ⟨1, fun k => if k = i then -1 else 1, 0, fun x => ?_⟩
    rw [add_zero]
    funext k
    by_cases h : k = i
    · subst h; simp [AffAut.refl, reflT, co]
    · simp [AffAut.refl, reflT, co, h]
  | perm σ =>
    refine ⟨σ.symm, 1, 0, fun x => ?_⟩
    rw [add_zero]
    funext k
    simp [AffAut.perm, permT, co]
  | comp _ _ ih₁ ih₂ =>
    obtain ⟨π₁, s₁, t₁, h₁⟩ := ih₁
    obtain ⟨π₂, s₂, t₂, h₂⟩ := ih₂
    refine ⟨π₂.trans π₁, fun i => s₂ i * s₁ (π₂ i),
      (show Lam d L N from fun i => ((s₂ i : ℤ) : ZMod (L ^ N)) * co t₁ (π₂ i)) + t₂,
      fun x => ?_⟩
    show _ = _
    simp only [AffAut.comp, Equiv.trans_apply]
    rw [h₂, h₁]
    funext i
    change ((s₂ i : ℤ) : ZMod (L ^ N)) * (((s₁ (π₂ i) : ℤ) : ZMod (L ^ N)) * x (π₁ (π₂ i)) +
        t₁ (π₂ i)) + t₂ i = (((s₂ i * s₁ (π₂ i) : ℤˣ) : ℤ) : ZMod (L ^ N)) * x (π₁ (π₂ i)) +
      (((s₂ i : ℤ) : ZMod (L ^ N)) * t₁ (π₂ i) + t₂ i)
    push_cast
    ring

theorem supNorm_signedPerm (π : Equiv.Perm (Fin d)) (s : Fin d → ℤˣ) (z : Lam d L N) :
    supNorm (show Lam d L N from fun i => ((s i : ℤ) : ZMod (L ^ N)) * co z (π i)) =
      supNorm z := by
  have hz : ∀ i, zabs (((s i : ℤ) : ZMod (L ^ N)) * co z (π i)) = zabs (co z (π i)) := by
    intro i
    rcases Int.units_eq_one_or (s i) with h | h
    · simp [h]
    · simp [h, zabs_neg]
  show univ.sup (fun i => zabs (((s i : ℤ) : ZMod (L ^ N)) * co z (π i))) =
    univ.sup (fun i => zabs (co z i))
  simp only [hz]
  refine le_antisymm (Finset.sup_le fun i _ => ?_) (Finset.sup_le fun i _ => ?_)
  · exact Finset.le_sup (f := fun i => zabs (co z i)) (mem_univ (π i))
  · have := Finset.le_sup (f := fun i => zabs (co z (π i))) (mem_univ (π.symm i))
    simpa only [Equiv.apply_symm_apply] using this

theorem IsGen.supNorm_sub {T : AffAut d L N} (hT : IsGen T) (x y : Lam d L N) :
    supNorm (T.E x - T.E y) = supNorm (x - y) := by
  obtain ⟨π, s, t, h⟩ := hT.exists_form
  rw [h, h, add_sub_add_right_eq_sub, ← supNorm_signedPerm π s (x - y)]
  congr 1
  funext i
  show ((s i : ℤ) : ZMod (L ^ N)) * x (π i) - ((s i : ℤ) : ZMod (L ^ N)) * y (π i) =
    ((s i : ℤ) : ZMod (L ^ N)) * (x (π i) - y (π i))
  ring

/-- Generated automorphisms have generated inverses. -/
theorem IsGen.exists_inv {T : AffAut d L N} (hT : IsGen T) :
    ∃ T' : AffAut d L N, IsGen T' ∧ ∀ x, T'.E (T.E x) = x := by
  induction hT with
  | transl t =>
    refine ⟨AffAut.transl (-t), IsGen.transl _, fun x => ?_⟩
    show x + t + -t = x
    abel
  | refl i =>
    refine ⟨AffAut.refl i, IsGen.refl i, fun x => ?_⟩
    funext k
    by_cases h : k = i
    · subst h; simp [AffAut.refl, reflT, co]
    · simp [AffAut.refl, reflT, co, h]
  | perm σ =>
    refine ⟨AffAut.perm σ.symm, IsGen.perm _, fun x => ?_⟩
    funext k
    simp [AffAut.perm, permT, co]
  | comp _ _ ih₁ ih₂ =>
    obtain ⟨T₁', h₁, e₁⟩ := ih₁
    obtain ⟨T₂', h₂, e₂⟩ := ih₂
    refine ⟨T₂'.comp T₁', IsGen.comp h₂ h₁, fun x => ?_⟩
    simp only [AffAut.comp, Equiv.trans_apply, e₁, e₂]

theorem mem_img_iff (T : AffAut d L N) {X : Finset (Lam d L N)} {y : Lam d L N} :
    y ∈ T.img X ↔ ∃ x ∈ X, T.E x = y := by
  simp only [AffAut.img, Finset.mem_map, Equiv.coe_toEmbedding]

theorem E_mem_img (T : AffAut d L N) {X : Finset (Lam d L N)} {x : Lam d L N} :
    T.E x ∈ T.img X ↔ x ∈ X := Finset.mem_map' _

theorem IsGen.touch_img {T : AffAut d L N} (hT : IsGen T) (X Y : Finset (Lam d L N)) :
    Touch (T.img X) (T.img Y) ↔ Touch X Y := by
  constructor
  · rintro ⟨x', hx', y', hy', h⟩
    obtain ⟨x, hx, rfl⟩ := (mem_img_iff T).1 hx'
    obtain ⟨y, hy, rfl⟩ := (mem_img_iff T).1 hy'
    exact ⟨x, hx, y, hy, by rwa [hT.supNorm_sub] at h⟩
  · rintro ⟨x, hx, y, hy, h⟩
    exact ⟨T.E x, (E_mem_img T).2 hx, T.E y, (E_mem_img T).2 hy, by rwa [hT.supNorm_sub]⟩

/-! ### Blocks -/

theorem presK_coord {T : AffAut d L N} {π : Equiv.Perm (Fin d)} {s : Fin d → ℤˣ}
    {t : Lam d L N} (hf : ∀ x, T.E x =
      (show Lam d L N from fun i => ((s i : ℤ) : ZMod (L ^ N)) * co x (π i)) + t)
    {j : ℕ} (h : PresBlocks j T) (i : Fin d) :
    PresK (L ^ j) (fun v : ZMod (L ^ N) => ((s i : ℤ) : ZMod (L ^ N)) * v + co t i) := by
  intro v w hvw
  have := congrFun (h (show Lam d L N from Pi.single (π i) v)
    (show Lam d L N from Pi.single (π i) w) ?_) i
  · have e : ∀ u : ZMod (L ^ N), co (T.E (show Lam d L N from Pi.single (π i) u)) i =
        ((s i : ℤ) : ZMod (L ^ N)) * u + co t i := fun u => by
      rw [hf]
      show ((s i : ℤ) : ZMod (L ^ N)) * (Pi.single (π i) u : Fin d → ZMod (L ^ N)) (π i) +
        t i = _
      rw [Pi.single_eq_same]
    simp only [blk] at this
    rw [e, e] at this
    exact this
  · funext q
    by_cases hq : q = π i
    · subst hq; simpa [blk, co] using hvw
    · simp [blk, co, hq]

theorem presBlocks_of_form {T : AffAut d L N} {π : Equiv.Perm (Fin d)} {s : Fin d → ℤˣ}
    {t : Lam d L N} (hf : ∀ x, T.E x =
      (show Lam d L N from fun i => ((s i : ℤ) : ZMod (L ^ N)) * co x (π i)) + t)
    {j : ℕ} (hP : ∀ i, PresK (L ^ j)
      (fun v : ZMod (L ^ N) => ((s i : ℤ) : ZMod (L ^ N)) * v + co t i)) :
    PresBlocks j T := by
  intro x y hxy
  funext i
  have := congrFun hxy (π i)
  simp only [blk] at this ⊢
  rw [hf, hf]
  exact hP i _ _ this

/-- Maps preserving `(j+1)`-blocks preserve `j`-blocks (for `j + 1 < N`; for `j + 1 = N`
every map preserves the single `N`-block, and the statement fails). -/
theorem PresBlocks.of_succ {T : AffAut d L N} (hT : IsGen T) {j : ℕ} (hj : j + 1 < N)
    (h : PresBlocks (j + 1) T) : PresBlocks j T := by
  obtain ⟨π, s, t, hf⟩ := hT.exists_form
  have hkn : L ^ j ∣ L ^ N := pow_dvd_pow L (by omega)
  have hmn : L ^ (j + 1) ∣ L ^ N := pow_dvd_pow L (by omega)
  have hkm : L ^ j ∣ L ^ (j + 1) := pow_dvd_pow L (by omega)
  rcases (Nat.one_le_iff_ne_zero.2 (NeZero.ne L)).eq_or_lt with hL | hL
  · intro x y hxy
    have : x = y := by
      funext i
      have := congrFun hxy i
      simp only [blk, ← hL, one_pow, Nat.div_one] at this
      exact ZMod.val_injective _ this
    rw [this]
  · have hlt : L ^ (j + 1) < L ^ N := Nat.pow_lt_pow_right hL hj
    refine presBlocks_of_form hf fun i => ?_
    have hP := presK_coord hf h i
    rcases Int.units_eq_one_or (s i) with hs | hs
    · simp only [hs, Units.val_one, Int.cast_one, one_mul] at hP ⊢
      exact presK_add hkn (dvd_trans hkm (dvd_of_presK hmn hlt hP))
    · simp only [hs, Units.val_neg, Units.val_one, Int.cast_neg, Int.cast_one, neg_one_mul]
        at hP ⊢
      have e : ∀ v : ZMod (L ^ N), -(-v - 1) + co t i = v + (co t i + 1) := fun v => by ring
      have hP' : PresK (L ^ (j + 1)) (· + (co t i + 1)) := fun v w hvw => by
        have := hP _ _ (presK_negsub hmn _ _ hvw)
        simp only [e] at this
        exact this
      exact presK_neg_add hkn (dvd_trans hkm (dvd_of_presK hmn hlt hP'))

theorem mem_blockIdx {j : ℕ} {b : Fin d → ℕ} :
    b ∈ blockIdx (L := L) (N := N) j ↔ (blockSet (L := L) (N := N) j b).Nonempty := by
  simp [blockIdx, blocks, blockSet, Finset.Nonempty]

theorem zero_mem_blockIdx (j : ℕ) : (0 : Fin d → ℕ) ∈ blockIdx (L := L) (N := N) j := by
  refine mem_image.2 ⟨0, mem_univ _, ?_⟩
  funext i
  show ((0 : ZMod (L ^ N))).val / L ^ j = 0
  simp

theorem card_blockSet {j : ℕ} (hj : j ≤ N) {b : Fin d → ℕ}
    (hb : b ∈ blockIdx (L := L) (N := N) j) :
    (blockSet (L := L) (N := N) j b).card = L ^ (j * d) := by
  obtain ⟨x0, hx0⟩ := mem_blockIdx.1 hb
  have hk0 : 0 < L ^ j := Nat.pos_of_ne_zero (pow_ne_zero _ (NeZero.ne L))
  have hbd := fun i => (block_bound hj hx0 i).2.2
  have : (blockSet (L := L) (N := N) j b).card = (Fintype.piFinset fun i =>
      univ.filter fun v : ZMod (L ^ N) => v.val / L ^ j = b i : Finset (Fin d → ZMod (L ^ N))).card :=
    Finset.card_nbij' (fun x => x) (fun x => x) (fun x hx => by
      rw [Finset.mem_coe, mem_blockSet] at hx
      simp only [Finset.mem_coe, Fintype.mem_piFinset, mem_filter, mem_univ, true_and]
      intro i; exact congrFun hx i)
      (fun x hx => by
        simp only [Finset.mem_coe, Fintype.mem_piFinset, mem_filter, mem_univ, true_and] at hx
        exact Finset.mem_coe.2 (mem_blockSet.2 (funext fun i => hx i)))
      (fun _ _ => rfl) (fun _ _ => rfl)
  rw [this, Fintype.card_piFinset]
  simp only [card_filter_div hk0 (hbd _), prod_const, card_univ, Fintype.card_fin]
  rw [← pow_mul, mul_comm]

theorem img_mono (T : AffAut d L N) {X Y : Finset (Lam d L N)} (h : X ⊆ Y) :
    T.img X ⊆ T.img Y := Finset.map_subset_map.2 h

theorem PresBlocks.img_blockSet {T : AffAut d L N} (hT : IsGen T) {j : ℕ} (hj : j ≤ N)
    (h : PresBlocks j T) {b : Fin d → ℕ} (hb : b ∈ blockIdx (L := L) (N := N) j) :
    ∃ b' ∈ blockIdx (L := L) (N := N) j, T.img (blockSet j b) = blockSet j b' := by
  obtain ⟨x0, hx0⟩ := mem_blockIdx.1 hb
  have hb' : blk j (T.E x0) ∈ blockIdx (L := L) (N := N) j := mem_image_of_mem _ (mem_univ _)
  refine ⟨blk j (T.E x0), hb', ?_⟩
  have hsub : T.img (blockSet j b) ⊆ blockSet j (blk j (T.E x0)) := by
    intro y hy
    obtain ⟨x, hx, rfl⟩ := (mem_img_iff T).1 hy
    rw [mem_blockSet] at hx hx0 ⊢
    exact h _ _ (hx.trans hx0.symm)
  refine Finset.eq_of_subset_of_card_le hsub ?_
  rw [T.card_img, card_blockSet hj hb, card_blockSet hj hb']

theorem PresBlocks.blk_iff {T : AffAut d L N} (hT : IsGen T) {j : ℕ} (hj : j ≤ N)
    (h : PresBlocks j T) {x y : Lam d L N} :
    blk j (T.E x) = blk j (T.E y) ↔ blk j x = blk j y := by
  refine ⟨fun hxy => ?_, h x y⟩
  have hb : blk j x ∈ blockIdx (L := L) (N := N) j := mem_image_of_mem _ (mem_univ _)
  obtain ⟨b', _, hb'⟩ := h.img_blockSet hT hj hb
  have hx : T.E x ∈ blockSet j b' := hb' ▸ (E_mem_img T).2 (mem_blockSet.2 rfl)
  have hy : T.E y ∈ blockSet j b' := by
    rw [mem_blockSet] at hx ⊢; rw [← hxy, hx]
  rw [← hb', E_mem_img, mem_blockSet] at hy
  exact hy.symm

/-- The inverse of a block preserving generated automorphism. -/
theorem PresBlocks.exists_inv {T : AffAut d L N} (hT : IsGen T) {j : ℕ} (hj : j ≤ N)
    (h : PresBlocks j T) : ∃ T' : AffAut d L N, IsGen T' ∧ PresBlocks j T' ∧
      (∀ X, T'.img (T.img X) = X) ∧ (∀ X, T.img (T'.img X) = X) := by
  obtain ⟨T', hT', e⟩ := hT.exists_inv
  have e' : ∀ y, T.E (T'.E y) = y := fun y => by
    obtain ⟨x, rfl⟩ := T.E.surjective y; rw [e]
  refine ⟨T', hT', fun x y hxy => ?_, fun X => ?_, fun X => ?_⟩
  · rw [← (h.blk_iff hT hj), e', e']; exact hxy
  · ext z; rw [mem_img_iff]
    constructor
    · rintro ⟨w, hw, rfl⟩
      obtain ⟨x, hx, rfl⟩ := (mem_img_iff T).1 hw
      rwa [e]
    · intro hz; exact ⟨T.E z, (E_mem_img T).2 hz, e z⟩
  · ext z; rw [mem_img_iff]
    constructor
    · rintro ⟨w, hw, rfl⟩
      obtain ⟨x, hx, rfl⟩ := (mem_img_iff T').1 hw
      rwa [e']
    · intro hz; exact ⟨T'.E z, (E_mem_img T').2 hz, e' z⟩

theorem PresBlocks.isPolymer_img {T : AffAut d L N} (hT : IsGen T) {j : ℕ} (hj : j ≤ N)
    (h : PresBlocks j T) {X : Finset (Lam d L N)} : IsPolymer j (T.img X) ↔ IsPolymer j X := by
  constructor
  · intro hX x y hxy hx
    exact (E_mem_img T).1 (hX _ _ (h x y hxy) ((E_mem_img T).2 hx))
  · intro hX x' y' hxy hx'
    obtain ⟨x, hx, rfl⟩ := (mem_img_iff T).1 hx'
    obtain ⟨y, rfl⟩ := T.E.surjective y'
    exact (E_mem_img T).2 (hX x y ((h.blk_iff hT hj).1 hxy) hx)

theorem card_image_eq_of_iff {α β γ : Type*} [DecidableEq β] [DecidableEq γ] {s : Finset α}
    {f : α → β} {g : α → γ} (h : ∀ x ∈ s, ∀ y ∈ s, f x = f y ↔ g x = g y) :
    (s.image f).card = (s.image g).card := by
  refine Finset.card_bij (fun b hb => g (Classical.choose (mem_image.1 hb))) ?_ ?_ ?_
  · intro b hb
    exact mem_image_of_mem _ (Classical.choose_spec (mem_image.1 hb)).1
  · intro b₁ hb₁ b₂ hb₂ heq
    have s₁ := Classical.choose_spec (mem_image.1 hb₁)
    have s₂ := Classical.choose_spec (mem_image.1 hb₂)
    rw [← s₁.2, ← s₂.2]
    exact (h _ s₁.1 _ s₂.1).2 heq
  · intro c hc
    obtain ⟨x, hx, rfl⟩ := mem_image.1 hc
    refine ⟨f x, mem_image_of_mem _ hx, ?_⟩
    have s₁ := Classical.choose_spec (mem_image.1 (mem_image_of_mem f hx))
    exact (h _ s₁.1 _ hx).1 s₁.2

theorem blocks_img (T : AffAut d L N) (j : ℕ) (X : Finset (Lam d L N)) :
    blocks j (T.img X) = X.image (fun x => blk j (T.E x)) := by
  rw [blocks, AffAut.img, map_eq_image, image_image]; rfl

theorem PresBlocks.nb_img {T : AffAut d L N} (hT : IsGen T) {j : ℕ} (hj : j ≤ N)
    (h : PresBlocks j T) (X : Finset (Lam d L N)) : nb j (T.img X) = nb j X := by
  rw [nb, nb, blocks_img, blocks]
  exact card_image_eq_of_iff (f := fun x => blk j (T.E x)) (g := blk j)
    fun x _ y _ => h.blk_iff hT hj

/-- The induced map on block indices. -/
def bmap (j : ℕ) (T : AffAut d L N) (b : Fin d → ℕ) : Fin d → ℕ :=
  open Classical in
  if hb : ∃ x : Lam d L N, blk j x = b then blk j (T.E hb.choose) else b

theorem bmap_blk {T : AffAut d L N} {j : ℕ} (h : PresBlocks j T) (x : Lam d L N) :
    bmap j T (blk j x) = blk j (T.E x) := by
  have hx : ∃ y : Lam d L N, blk j y = blk j x := ⟨x, rfl⟩
  rw [bmap, dif_pos hx]
  exact h _ _ hx.choose_spec

theorem PresBlocks.adj_map {T : AffAut d L N} (hT : IsGen T) {j : ℕ} (h : PresBlocks j T)
    {X : Finset (Lam d L N)} {b b' : Fin d → ℕ} (hbb : BlockAdj j X b b') :
    BlockAdj j (T.img X) (bmap j T b) (bmap j T b') := by
  obtain ⟨hb, hb', u, hu, v, hv, huv⟩ := hbb
  obtain ⟨x, hx, rfl⟩ := mem_image.1 hb
  obtain ⟨x', hx', rfl⟩ := mem_image.1 hb'
  rw [mem_blockSet] at hu hv
  refine ⟨?_, ?_, T.E u, ?_, T.E v, ?_, ?_⟩
  · rw [bmap_blk h, blocks_img]; exact mem_image_of_mem _ hx
  · rw [bmap_blk h, blocks_img]; exact mem_image_of_mem _ hx'
  · rw [mem_blockSet, bmap_blk h]; exact h _ _ hu
  · rw [mem_blockSet, bmap_blk h]; exact h _ _ hv
  · rwa [hT.supNorm_sub]

theorem PresBlocks.rtg_map {T : AffAut d L N} (hT : IsGen T) {j : ℕ} (h : PresBlocks j T)
    {X : Finset (Lam d L N)} {x y : Lam d L N}
    (hr : Relation.ReflTransGen (BlockAdj j X) (blk j x) (blk j y)) :
    Relation.ReflTransGen (BlockAdj j (T.img X)) (blk j (T.E x)) (blk j (T.E y)) := by
  have := Relation.ReflTransGen.lift (bmap j T) (fun a b hab => h.adj_map hT hab) hr
  rwa [bmap_blk h, bmap_blk h] at this

theorem PresBlocks.isConnected_img {T : AffAut d L N} (hT : IsGen T) {j : ℕ}
    (h : PresBlocks j T) {X : Finset (Lam d L N)} (hX : IsConnected j X) :
    IsConnected j (T.img X) := by
  refine ⟨T.img_nonempty hX.1, fun c hc c' hc' => ?_⟩
  rw [blocks_img] at hc hc'
  obtain ⟨x, hx, rfl⟩ := mem_image.1 hc
  obtain ⟨x', hx', rfl⟩ := mem_image.1 hc'
  exact h.rtg_map hT (hX.2 _ (mem_image_of_mem _ hx) _ (mem_image_of_mem _ hx'))

theorem PresBlocks.isConn_img {T : AffAut d L N} (hT : IsGen T) {j : ℕ} (hj : j ≤ N)
    (h : PresBlocks j T) {X : Finset (Lam d L N)} : IsConn j (T.img X) ↔ IsConn j X := by
  have fwd : ∀ {T : AffAut d L N}, IsGen T → PresBlocks j T → ∀ {X : Finset (Lam d L N)},
      IsConn j X → IsConn j (T.img X) := fun hT h X hX =>
    ⟨(h.isPolymer_img hT hj).2 hX.1, h.isConnected_img hT hX.2⟩
  refine ⟨fun hX => ?_, fwd hT h⟩
  obtain ⟨T', hT', h', e, -⟩ := h.exists_inv hT hj
  simpa [e] using fwd hT' h' hX

theorem PresBlocks.isSmall_img {T : AffAut d L N} (hT : IsGen T) {j : ℕ} (hj : j ≤ N)
    (h : PresBlocks j T) {X : Finset (Lam d L N)} : IsSmall j (T.img X) ↔ IsSmall j X := by
  have fwd : ∀ {T : AffAut d L N}, IsGen T → PresBlocks j T → ∀ {X : Finset (Lam d L N)},
      IsSmall j X → IsSmall j (T.img X) := fun hT h X hX =>
    ⟨(h.isPolymer_img hT hj).2 hX.1, h.isConnected_img hT hX.2.1, by
      have := h.nb_img hT hj X; unfold nb at this; rw [this]; exact hX.2.2⟩
  refine ⟨fun hX => ?_, fwd hT h⟩
  obtain ⟨T', hT', h', e, -⟩ := h.exists_inv hT hj
  simpa [e] using fwd hT' h' hX

theorem PresBlocks.img_nbhd_sub {T : AffAut d L N} (hT : IsGen T) {j : ℕ} (hj : j ≤ N)
    (h : PresBlocks j T) (X : Finset (Lam d L N)) : T.img (nbhd j X) ⊆ nbhd j (T.img X) := by
  intro z hz
  obtain ⟨y, hy, rfl⟩ := (mem_img_iff T).1 hz
  simp only [nbhd, mem_filter, mem_univ, true_and] at hy ⊢
  obtain ⟨S, hS, hyS, b, hb, hbS⟩ := hy
  obtain ⟨x, hx, rfl⟩ := mem_image.1 hb
  refine ⟨T.img S, (h.isSmall_img hT hj).2 hS, (E_mem_img T).2 hyS, blk j (T.E x), ?_, ?_⟩
  · rw [blocks_img]; exact mem_image_of_mem _ hx
  · intro z hz
    rw [mem_blockSet] at hz
    have hxS : x ∈ S := hbS (mem_blockSet.2 rfl)
    exact ((h.isPolymer_img hT hj).2 hS.1) _ _ hz.symm ((E_mem_img T).2 hxS)

theorem PresBlocks.nbhd_img {T : AffAut d L N} (hT : IsGen T) {j : ℕ} (hj : j ≤ N)
    (h : PresBlocks j T) (X : Finset (Lam d L N)) : nbhd j (T.img X) = T.img (nbhd j X) := by
  refine Finset.Subset.antisymm ?_ (h.img_nbhd_sub hT hj X)
  obtain ⟨T', hT', h', e, e'⟩ := h.exists_inv hT hj
  have := img_mono T (h'.img_nbhd_sub hT' hj (T.img X))
  rwa [e', e] at this

theorem PresBlocks.clo_img {T : AffAut d L N} (hT : IsGen T) {j : ℕ} (hj : j + 1 ≤ N)
    (h : PresBlocks (j + 1) T) (X : Finset (Lam d L N)) : clo j (T.img X) = T.img (clo j X) := by
  ext z
  obtain ⟨w, rfl⟩ := T.E.surjective z
  rw [E_mem_img]
  simp only [clo, mem_filter, mem_univ, true_and]
  rw [blocks_img, blocks, mem_image, mem_image]
  exact exists_congr fun y => and_congr_right fun _ => h.blk_iff hT hj

theorem PresBlocks.img_compOf {T : AffAut d L N} (hT : IsGen T) {j : ℕ} (hj : j ≤ N)
    (h : PresBlocks j T) (X : Finset (Lam d L N)) (x : Lam d L N) :
    T.img (compOf j X (blk j x)) = compOf j (T.img X) (blk j (T.E x)) := by
  obtain ⟨T', hT', h', e, -⟩ := h.exists_inv hT hj
  have e₁ : ∀ y, T'.E (T.E y) = y := fun y => by
    have := e {y}; simp [AffAut.img] at this; exact this
  ext z
  obtain ⟨y, rfl⟩ := T.E.surjective z
  rw [E_mem_img]
  simp only [compOf, mem_filter, E_mem_img]
  refine and_congr_right fun _ => ⟨fun hr => h.rtg_map hT hr, fun hr => ?_⟩
  have := h'.rtg_map hT' hr
  rwa [e, e₁, e₁] at this

theorem PresBlocks.comp_img {T : AffAut d L N} (hT : IsGen T) {j : ℕ} (hj : j ≤ N)
    (h : PresBlocks j T) (X : Finset (Lam d L N)) :
    Comp j (T.img X) = (Comp j X).image T.img := by
  rw [Comp, Comp, blocks_img, blocks, image_image, image_image, image_image]
  refine Finset.image_congr fun x _ => ?_
  exact (h.img_compOf hT hj X x).symm

theorem img_union (T : AffAut d L N) (X Y : Finset (Lam d L N)) :
    T.img (X ∪ Y) = T.img X ∪ T.img Y := Finset.map_union _ _

theorem img_sdiff (T : AffAut d L N) (X Y : Finset (Lam d L N)) :
    T.img (X \ Y) = T.img X \ T.img Y := Finset.map_sdiff _ _

theorem img_univ (T : AffAut d L N) : T.img (univ : Finset (Lam d L N)) = univ :=
  Finset.map_univ_equiv _

theorem img_injective (T : AffAut d L N) : Function.Injective (T.img (d := d) (L := L) (N := N)) :=
  Finset.map_injective _

/-! ### Equivariance of local polynomials -/

theorem IsGen.exists_dir {T : AffAut d L N} (hT : IsGen T) :
    ∃ ρ : Dir d ≃ Dir d, ∀ e, T.R (dirVec e) = dirVec (ρ e) := by
  induction hT with
  | transl t => exact ⟨Equiv.refl _, fun e => rfl⟩
  | refl i =>
    refine ⟨Equiv.swap (Sum.inl i) (Sum.inr i), fun e => ?_⟩
    show (reflT i) (dirVec e) = _
    rcases e with k | k <;> by_cases hk : k = i
    · subst hk
      rw [Equiv.swap_apply_left]
      funext m; by_cases hm : m = k <;> simp [reflT, dirVec, co, hm]
    · rw [Equiv.swap_apply_of_ne_of_ne (by simp [hk]) (by simp)]
      funext m; by_cases hm : m = i <;> simp [reflT, dirVec, co, hm, Pi.single_apply, Ne.symm hk]
    · subst hk
      rw [Equiv.swap_apply_right]
      funext m; by_cases hm : m = k <;> simp [reflT, dirVec, co, hm]
    · rw [Equiv.swap_apply_of_ne_of_ne (by simp) (by simp [hk])]
      funext m; by_cases hm : m = i <;> simp [reflT, dirVec, co, hm, Pi.single_apply, Ne.symm hk]
  | perm σ =>
    refine ⟨Equiv.sumCongr σ σ, fun e => ?_⟩
    show (permT σ) (dirVec e) = _
    rcases e with k | k <;> funext m <;>
      simp [permT, dirVec, co, Pi.single_apply, Equiv.symm_apply_eq]
  | comp _ _ ih₁ ih₂ =>
    obtain ⟨ρ₁, h₁⟩ := ih₁
    obtain ⟨ρ₂, h₂⟩ := ih₂
    refine ⟨ρ₁.trans ρ₂, fun e => ?_⟩
    show _ = dirVec (ρ₂ (ρ₁ e))
    simp only [AffAut.comp, AddMonoidHom.comp_apply, h₁, h₂]

section EvalImg

variable (T : AffAut d L N) (ρ : Dir d ≃ Dir d) (hρ : ∀ e, T.R (dirVec e) = dirVec (ρ e))
include hρ

theorem E_add_dir (y : Lam d L N) (e : Dir d) : T.E (y + dirVec e) = T.E y + dirVec (ρ e) := by
  rw [T.hE, T.hE y, map_add, hρ]; abel

theorem E_sub_dir (y : Lam d L N) (e : Dir d) : T.E (y - dirVec e) = T.E y - dirVec (ρ e) := by
  rw [T.hE, T.hE y, map_sub, hρ]; abel

theorem autAlg_grad (e : Dir d) (y : Lam d L N) :
    autAlg T.E (grad e y) = grad (ρ e) (T.E y) := by
  simp only [grad, map_sub, autAlg_psi, E_add_dir T ρ hρ]

theorem autAlg_gradbar (e : Dir d) (y : Lam d L N) :
    autAlg T.E (gradbar e y) = gradbar (ρ e) (T.E y) := by
  simp only [gradbar, map_sub, autAlg_psibar, E_add_dir T ρ hρ]

theorem autAlg_lapPsi (y : Lam d L N) : autAlg T.E (lapPsi y) = lapPsi (T.E y) := by
  simp only [lapPsi, map_smul, map_sum, map_sub, autAlg_grad T ρ hρ, E_sub_dir T ρ hρ]
  congr 1
  exact Fintype.sum_equiv ρ _ _ fun e => rfl

theorem autAlg_lapPsibar (y : Lam d L N) : autAlg T.E (lapPsibar y) = lapPsibar (T.E y) := by
  simp only [lapPsibar, map_smul, map_sum, map_sub, autAlg_gradbar T ρ hρ, E_sub_dir T ρ hρ]
  congr 1
  exact Fintype.sum_equiv ρ _ _ fun e => rfl

theorem autAlg_gradSq (y : Lam d L N) : autAlg T.E (gradSq y) = gradSq (T.E y) := by
  simp only [gradSq, map_smul, map_sum, map_mul, autAlg_grad T ρ hρ, autAlg_gradbar T ρ hρ]
  congr 1
  exact Fintype.sum_equiv ρ _ _ fun e => rfl

end EvalImg

theorem IsGen.eval_img {T : AffAut d L N} (hT : IsGen T) (V : Vcoup) (X : Finset (Lam d L N)) :
    autAlg T.E (V.eval X) = V.eval (T.img X) := by
  obtain ⟨ρ, hρ⟩ := hT.exists_dir
  rw [Vcoup.eval, map_sum, Vcoup.eval, AffAut.img, sum_map]
  refine sum_congr rfl fun x _ => ?_
  simp only [map_add, map_smul, map_mul, map_neg, autAlg_psi, autAlg_psibar,
    autAlg_gradSq T ρ hρ, autAlg_lapPsi T ρ hρ, autAlg_lapPsibar T ρ hρ]
  rfl

/-! ### The automorphisms of Section `sec:Loc` -/

theorem isGen_reflCenter (j : ℕ) (b : Fin d → ℕ) (i : Fin d) :
    IsGen (reflCenter (L := L) (N := N) j b i) :=
  IsGen.comp (IsGen.refl i) (IsGen.transl _)

theorem isGen_permCorner (j : ℕ) (b : Fin d → ℕ) (σ : Equiv.Perm (Fin d)) :
    IsGen (permCorner (L := L) (N := N) j b σ) :=
  IsGen.comp (IsGen.transl _) (IsGen.comp (IsGen.perm σ) (IsGen.transl _))

theorem dvd_val_corner {j : ℕ} (hj : j ≤ N) (b : Fin d → ℕ) (m : Fin d) :
    L ^ j ∣ (co (corner (L := L) (N := N) j b) m).val :=
  dvd_val_natCast (pow_dvd_pow L hj) (dvd_mul_left _ _)

theorem presBlocks_reflCenter {j : ℕ} (hj : j ≤ N) {b : Fin d → ℕ}
    (hb : b ∈ blockIdx (L := L) (N := N) j) (i : Fin d) :
    PresBlocks j (reflCenter (L := L) (N := N) j b i) := by
  have hkn : L ^ j ∣ L ^ N := pow_dvd_pow L hj
  intro x y hxy
  funext k
  have hco : ∀ y : Lam d L N, co ((reflCenter (L := L) (N := N) j b i).E y) k =
      (if k = i then -co y k else co y k) +
        (Pi.single i (((2 * (b i * L ^ j) + L ^ j - 1 : ℕ)) : ZMod (L ^ N)) :
          Fin d → ZMod (L ^ N)) k := fun y => rfl
  have := congrFun hxy k
  simp only [blk] at this ⊢
  rw [hco, hco]
  by_cases hk : k = i
  · subst hk
    simp only [if_true, Pi.single_eq_same]
    refine presK_neg_add hkn ?_ _ _ this
    have hL : 1 ≤ L ^ j := Nat.one_le_iff_ne_zero.2 (pow_ne_zero _ (NeZero.ne L))
    rw [show (((2 * (b k * L ^ j) + L ^ j - 1 : ℕ)) : ZMod (L ^ N)) + 1 =
      ((2 * (b k * L ^ j) + L ^ j : ℕ) : ZMod (L ^ N)) by
        push_cast [Nat.cast_sub (show 1 ≤ 2 * (b k * L ^ j) + L ^ j by omega)]; ring]
    exact dvd_val_natCast hkn ⟨2 * b k + 1, by ring⟩
  · simp only [if_neg hk, Pi.single_eq_of_ne hk, add_zero]
    exact this

theorem presBlocks_permCorner {j : ℕ} (hj : j ≤ N) {b : Fin d → ℕ}
    (hb : b ∈ blockIdx (L := L) (N := N) j) (σ : Equiv.Perm (Fin d)) :
    PresBlocks j (permCorner (L := L) (N := N) j b σ) := by
  have hkn : L ^ j ∣ L ^ N := pow_dvd_pow L hj
  intro x y hxy
  funext k
  have hco : ∀ y : Lam d L N, co ((permCorner (L := L) (N := N) j b σ).E y) k =
      co y (σ.symm k) + (-co (corner (L := L) (N := N) j b) (σ.symm k) +
        co (corner (L := L) (N := N) j b) k) := fun y => by
    show co (y + -corner j b) (σ.symm k) + co (corner j b) k = _
    rw [co_add, co_neg]
    simp only [Pi.add_apply, Pi.neg_apply]
    ring
  have := congrFun hxy (σ.symm k)
  simp only [blk] at this ⊢
  rw [hco, hco]
  exact presK_add hkn (dvd_val_add hkn (dvd_val_neg hkn (dvd_val_corner hj b _))
    (dvd_val_corner hj b _)) _ _ this

theorem presBlocks_transl_corner {j : ℕ} (hj : j ≤ N) (b : Fin d → ℕ) :
    PresBlocks j (AffAut.transl (corner (L := L) (N := N) j b)) := by
  have hkn : L ^ j ∣ L ^ N := pow_dvd_pow L hj
  intro x y hxy
  funext k
  have := congrFun hxy k
  simp only [blk] at this ⊢
  exact presK_add hkn (dvd_val_corner hj b k) _ _ this

theorem transl_corner_img {j : ℕ} (hj : j ≤ N) {b : Fin d → ℕ}
    (hb : b ∈ blockIdx (L := L) (N := N) j) :
    (AffAut.transl (corner (L := L) (N := N) j b)).img (blockSet j 0) = blockSet j b := by
  obtain ⟨x0, hx0⟩ := mem_blockIdx.1 hb
  have hk0 : 0 < L ^ j := Nat.pos_of_ne_zero (pow_ne_zero _ (NeZero.ne L))
  have hsub : (AffAut.transl (corner (L := L) (N := N) j b)).img (blockSet j 0) ⊆
      blockSet j b := by
    intro y hy
    obtain ⟨x, hx, rfl⟩ := (mem_img_iff _).1 hy
    rw [mem_blockSet_iff] at hx ⊢
    intro i
    have hbd := (block_bound hj hx0 i).2.2
    have hxi : (co x i).val < L ^ j := by
      have := hx i; simp only [Pi.zero_apply] at this
      exact (Nat.div_eq_zero_iff_lt hk0).1 this
    show (co x i + ((b i * L ^ j : ℕ) : ZMod (L ^ N))).val / L ^ j = b i
    rw [← ZMod.natCast_zmod_val (co x i), ← Nat.cast_add,
      ZMod.val_natCast_of_lt (by omega)]
    exact div_eq_of_bounds hk0 (by omega) (by omega)
  refine Finset.eq_of_subset_of_card_le hsub ?_
  rw [AffAut.card_img, card_blockSet hj hb, card_blockSet hj (zero_mem_blockIdx j)]

end

end Step
