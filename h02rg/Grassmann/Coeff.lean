import Grassmann.Algebra

-- Merged from `Grassmann/Basic.lean` (phase 3).
section

/-!
# Grassmann algebras `𝒩(Λ)`

Notation of Sections `sec:grassm-gauss-integr` and `sec:norms` of `h02rg.tex`.

* `Λ` is a finite set of sites, `Λ_f = Λ × {±1}` (here `Λ × ℤˣ`), and for `a = (x, σ) ∈ Λ_f`
  the generator `ψ_a` is `ψ_x` if `σ = +1` and `ψ̄_x` if `σ = -1`.
* `𝒩(Λ)` is the complex exterior algebra over the vector space `Λ_f → ℂ`, where the basis vector
  `Pi.single a 1` is the generator `ψ_a`.
* `∂_a` is the (left, odd) derivative `∂/∂ψ_a`, i.e. contraction with the coordinate functional
  of `a`.
* For a finite sequence `z = (z_1, …, z_n)` in `Λ_f` we write `ψ^z = ψ_{z_1} ⋯ ψ_{z_n}`;
  sequences of length `n` are functions `Fin n → Λ_f`.
-/

namespace Grassmann

noncomputable section

open CliffordAlgebra

/-- `Λ_f = Λ × {±1}`. -/
abbrev Sf (Λ : Type*) := Λ × ℤˣ

/-- The complex vector space spanned by the generators `ψ_a`, `a ∈ Λ_f`. -/
abbrev V (Λ : Type*) := Sf Λ → ℂ

/-- The Grassmann algebra `𝒩(Λ)` generated by `ψ_x, ψ̄_x`, `x ∈ Λ`. -/
abbrev N (Λ : Type*) := ExteriorAlgebra ℂ (V Λ)

variable {Λ : Type*} [DecidableEq Λ]

/-- The generator vector of `ψ_a`. -/
def ev (a : Sf Λ) : V Λ := Pi.single a 1

/-- The generator `ψ_a`, `a ∈ Λ_f`. -/
def ψ (a : Sf Λ) : N Λ := ExteriorAlgebra.ι ℂ (ev a)

/-- `ψ_x = ψ_{(x,+1)}`. -/
def psi (x : Λ) : N Λ := ψ (x, 1)

/-- `ψ̄_x = ψ_{(x,-1)}`. -/
def psibar (x : Λ) : N Λ := ψ (x, -1)

/-- The derivative `∂/∂ψ_a`. -/
def D (a : Sf Λ) : N Λ →ₗ[ℂ] N Λ :=
  contractLeft (LinearMap.proj (R := ℂ) (φ := fun _ : Sf Λ => ℂ) a)

/-- The constant term (the "evaluation at `ψ = 0`") `𝒩(Λ) → ℂ`. -/
abbrev ε : N Λ →ₐ[ℂ] ℂ := ExteriorAlgebra.algebraMapInv

/-- `ψ^z = ψ_{z_1} ⋯ ψ_{z_n}`. -/
def psiPow {n : ℕ} (z : Fin n → Sf Λ) : N Λ := ExteriorAlgebra.ιMulti ℂ n (fun i => ev (z i))

/-- The coordinate functional of `a ∈ Λ_f`. -/
abbrev coord (a : Sf Λ) : Module.Dual ℂ (V Λ) := LinearMap.proj (R := ℂ) (φ := fun _ => ℂ) a

/-- The iterated derivative `∂_{z_n} ⋯ ∂_{z_1}` (with `∂_{z_1}` applied first). -/
def Dseq {n : ℕ} (z : Fin n → Sf Λ) : N Λ →ₗ[ℂ] N Λ := contr fun i => coord (z i)

/-- The coefficient `F_z` of `F ∈ 𝒩(Λ)` in the representation `F = ∑_z (1/z!) F_z ψ^z`
(`e:Fzsum`): `F_z = (∂_{z_n} ⋯ ∂_{z_1} F)|_{ψ=0}`.  It is antisymmetric in `z`
(`coeff_perm`) and `e:Fzsum` holds with it (`sum_coeff`); it is the unique antisymmetric
choice (`coeff_eq_of_antisymm`). -/
def coeff (F : N Λ) {n : ℕ} (z : Fin n → Sf Λ) : ℂ := ε (Dseq z F)

end

end Grassmann

end

/-!
# The coefficients `F_z` and the representation `e:Fzsum`

For `F ∈ 𝒩(Λ)` the coefficients `F_z = coeff F z` are antisymmetric in `z`, vanish for `z` with
repeated entries (hence for `z` of length exceeding `|Λ_f| = 2|Λ|`), and
`F = ∑_{z ∈ Λ_f^*} (1/z!) F_z ψ^z` (`sum_coeff`).  Conversely any antisymmetric family `G` with
`F = ∑ (1/z!) G_z ψ^z` agrees with the coefficients of `F` (`coeff_eq_of_antisymm`).
-/

namespace Grassmann

noncomputable section

open CliffordAlgebra ExteriorAlgebra Equiv

variable {Λ : Type*} [DecidableEq Λ]

/-- `F ↦ F_z` is linear. -/
def coeffL {n : ℕ} (z : Fin n → Sf Λ) : N Λ →ₗ[ℂ] ℂ := (ε : N Λ →ₐ[ℂ] ℂ).toLinearMap ∘ₗ Dseq z

theorem coeffL_apply {n : ℕ} (z : Fin n → Sf Λ) (F : N Λ) : coeffL z F = coeff F z := rfl

@[simp] theorem coeff_add (F G : N Λ) {n : ℕ} (z : Fin n → Sf Λ) :
    coeff (F + G) z = coeff F z + coeff G z := map_add (coeffL z) F G

@[simp] theorem coeff_smul (r : ℂ) (F : N Λ) {n : ℕ} (z : Fin n → Sf Λ) :
    coeff (r • F) z = r * coeff F z := map_smul (coeffL z) r F

@[simp] theorem coeff_zero {n : ℕ} (z : Fin n → Sf Λ) : coeff (0 : N Λ) z = 0 :=
  map_zero (coeffL z)

theorem coeff_sum {ι : Type*} (s : Finset ι) (F : ι → N Λ) {n : ℕ} (z : Fin n → Sf Λ) :
    coeff (∑ i ∈ s, F i) z = ∑ i ∈ s, coeff (F i) z := map_sum (coeffL z) F s

/-- Coefficients of a product of `n` vectors: `(ι v_1 ⋯ ι v_n)_z = det (v_j(z_i))`. -/
theorem coeff_ιMulti {n : ℕ} (v : Fin n → V Λ) (z : Fin n → Sf Λ) :
    coeff (ιMulti ℂ n v) z = (Matrix.of fun i j => v j (z i)).det := by
  rw [coeff, Dseq, algebraMapInv_contr_ιMulti]; rfl

theorem coeff_ιMulti_of_ne {m n : ℕ} (v : Fin n → V Λ) (z : Fin m → Sf Λ) (h : m ≠ n) :
    coeff (ιMulti ℂ n v) z = 0 := algebraMapInv_contr_ιMulti_of_ne _ _ h

/-- Induction principle: `𝒩(Λ)` is spanned by products `ι v_1 ⋯ ι v_n`. -/
theorem induction_ιMulti {P : N Λ → Prop} (hzero : P 0) (hadd : ∀ F G, P F → P G → P (F + G))
    (hsmul : ∀ (r : ℂ) F, P F → P (r • F)) (hι : ∀ n (v : Fin n → V Λ), P (ιMulti ℂ n v))
    (F : N Λ) : P F := by
  have hF : F ∈ Submodule.span ℂ (Set.range fun x : Σ n, (Fin n → V Λ) => ιMulti ℂ x.1 x.2) := by
    rw [ιMulti_span]; trivial
  induction hF using Submodule.span_induction with
  | mem x hx => obtain ⟨⟨n, v⟩, rfl⟩ := hx; exact hι n v
  | zero => exact hzero
  | add x y _ _ hx hy => exact hadd x y hx hy
  | smul r x _ hx => exact hsmul r x hx

/-- Antisymmetry of the coefficients. -/
theorem coeff_perm (F : N Λ) {n : ℕ} (z : Fin n → Sf Λ) (σ : Perm (Fin n)) :
    coeff F (z ∘ σ) = (Perm.sign σ : ℂ) * coeff F z := by
  induction F using induction_ιMulti with
  | hzero => simp
  | hadd F G hF hG => rw [coeff_add, coeff_add, hF, hG, mul_add]
  | hsmul r F hF => rw [coeff_smul, coeff_smul, hF]; ring
  | hι m v =>
    by_cases h : n = m
    · subst h
      rw [coeff_ιMulti, coeff_ιMulti]
      have := Matrix.det_permute σ (Matrix.of fun i j => v j (z i))
      rw [← this]; rfl
    · rw [coeff_ιMulti_of_ne _ _ h, coeff_ιMulti_of_ne _ _ h, mul_zero]

theorem coeff_eq_zero_of_not_injective (F : N Λ) {n : ℕ} {z : Fin n → Sf Λ}
    (hz : ¬Function.Injective z) : coeff F z = 0 := by
  obtain ⟨i, j, hij, hne⟩ : ∃ i j, z i = z j ∧ i ≠ j := by
    simpa [Function.Injective, not_forall] using hz
  have h1 : z ∘ Equiv.swap i j = z := by
    funext k
    by_cases hki : k = i
    · subst hki; simp [hij]
    · by_cases hkj : k = j
      · subst hkj; simp [hij]
      · simp [Equiv.swap_apply_of_ne_of_ne hki hkj]
  have := coeff_perm F z (Equiv.swap i j)
  rw [h1, Perm.sign_swap hne] at this
  push_cast at this
  linear_combination this / 2

variable [Fintype Λ]

/-- `|Λ_f| = 2|Λ|`, the maximal length of a sequence without repetitions. -/
abbrev Nf (Λ : Type*) [Fintype Λ] : ℕ := Fintype.card (Sf Λ)

theorem coeff_eq_zero_of_lt (F : N Λ) {n : ℕ} (z : Fin n → Sf Λ) (hn : Nf Λ < n) :
    coeff F z = 0 :=
  coeff_eq_zero_of_not_injective F fun hz => by
    have := Fintype.card_le_of_injective z hz
    rw [Fintype.card_fin] at this
    exact absurd this (Nat.not_le.2 hn)

theorem ιMulti_eq_zero_of_lt {n : ℕ} (v : Fin n → V Λ) (hn : Nf Λ < n) : ιMulti ℂ n v = 0 := by
  apply AlternatingMap.map_linearDependent
  intro hli
  have := hli.fintype_card_le_finrank
  rw [Fintype.card_fin, Module.finrank_fintype_fun_eq_card] at this
  exact absurd this (Nat.not_le.2 hn)

theorem psiPow_perm {n : ℕ} (z : Fin n → Sf Λ) (σ : Perm (Fin n)) :
    psiPow (z ∘ σ) = (Perm.sign σ : ℂ) • psiPow z := by
  rw [psiPow, psiPow, show (fun i => ev ((z ∘ σ) i)) = (fun i => ev (z i)) ∘ σ from rfl,
    AlternatingMap.map_perm]
  rw [Units.smul_def, ← Int.cast_smul_eq_zsmul ℂ]

/-- Multilinear expansion: `ι v_1 ⋯ ι v_n = ∑_z (∏_i v_i(z_i)) ψ^z`. -/
theorem ιMulti_eq_sum {n : ℕ} (v : Fin n → V Λ) :
    ιMulti ℂ n v = ∑ z : Fin n → Sf Λ, (∏ i, v i (z i)) • psiPow z := by
  have hv : v = fun i => ∑ a : Sf Λ, v i a • ev a := by
    ext i b; simp [ev, Finset.sum_apply, Pi.single_apply]
  conv_lhs => rw [hv]
  rw [← AlternatingMap.coe_multilinearMap, MultilinearMap.map_sum]
  refine Finset.sum_congr rfl fun z _ => ?_
  rw [MultilinearMap.map_smul_univ]; rfl

/-- `coeff (ψ^z) w = ∑_σ sgn σ [z = w ∘ σ]`. -/
theorem coeff_psiPow {n : ℕ} (z w : Fin n → Sf Λ) :
    coeff (psiPow z) w = ∑ σ : Perm (Fin n), (Perm.sign σ : ℂ) * if z = w ∘ σ then 1 else 0 := by
  rw [psiPow, coeff_ιMulti, Matrix.det_apply]
  refine Finset.sum_congr rfl fun σ _ => ?_
  rw [Units.smul_def, ← Int.cast_smul_eq_zsmul ℂ, smul_eq_mul]
  congr 1
  simp only [Matrix.of_apply, ev, Pi.single_apply]
  by_cases h : z = w ∘ σ
  · subst h; simp
  · rw [if_neg h]
    obtain ⟨i, hi⟩ : ∃ i, z i ≠ w (σ i) := by
      by_contra hc; push Not at hc; exact h (funext hc)
    exact Finset.prod_eq_zero (Finset.mem_univ i) (by simp [Ne.symm hi])

/-- `coeff (∑_z c_z ψ^z) w = ∑_σ sgn σ c_{w ∘ σ}`. -/
theorem coeff_sum_psiPow {n : ℕ} (c : (Fin n → Sf Λ) → ℂ) (w : Fin n → Sf Λ) :
    coeff (∑ z, c z • psiPow z) w = ∑ σ : Perm (Fin n), (Perm.sign σ : ℂ) * c (w ∘ σ) := by
  rw [coeff_sum]
  simp_rw [coeff_smul, coeff_psiPow, Finset.mul_sum]
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun σ _ => ?_
  rw [Finset.sum_eq_single (w ∘ σ)]
  · simp; ring
  · intro z _ hz; simp [hz]
  · simp

theorem coeff_sum_psiPow_of_ne {m n : ℕ} (c : (Fin n → Sf Λ) → ℂ) (w : Fin m → Sf Λ)
    (h : m ≠ n) : coeff (∑ z, c z • psiPow z) w = 0 := by
  rw [coeff_sum]
  exact Finset.sum_eq_zero fun z _ => by rw [coeff_smul, psiPow, coeff_ιMulti_of_ne _ _ h, mul_zero]

/-- The representation `e:Fzsum`: `F = ∑_{z ∈ Λ_f^*} (1/z!) F_z ψ^z`, where sequences of length
exceeding `|Λ_f|` do not contribute (`coeff_eq_zero_of_lt`). -/
theorem sum_coeff (F : N Λ) :
    F = ∑ n ∈ Finset.range (Nf Λ + 1), ∑ z : Fin n → Sf Λ,
      ((n.factorial : ℂ)⁻¹ * coeff F z) • psiPow z := by
  induction F using induction_ιMulti with
  | hzero => simp
  | hadd F G hF hG =>
    conv_lhs => rw [hF, hG]
    rw [← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun n _ => ?_
    rw [← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun z _ => ?_
    rw [coeff_add, mul_add, add_smul]
  | hsmul r F hF =>
    conv_lhs => rw [hF]
    rw [Finset.smul_sum]
    refine Finset.sum_congr rfl fun n _ => ?_
    rw [Finset.smul_sum]
    refine Finset.sum_congr rfl fun z _ => ?_
    rw [coeff_smul, smul_smul]; ring_nf
  | hι m v =>
    by_cases hm : Nf Λ < m
    · conv_lhs => rw [ιMulti_eq_zero_of_lt v hm]
      refine (Finset.sum_eq_zero fun n hn => Finset.sum_eq_zero fun z _ => ?_).symm
      have hn' := Finset.mem_range.1 hn
      rw [coeff_ιMulti_of_ne _ _ (by omega), mul_zero, zero_smul]
    · rw [Finset.sum_eq_single_of_mem m (Finset.mem_range.2 (by omega))]
      · conv_lhs => rw [ιMulti_eq_sum]
        simp_rw [coeff_ιMulti, Matrix.det_apply, Finset.mul_sum, Finset.sum_smul]
        rw [Finset.sum_comm]
        symm
        calc ∑ σ : Perm (Fin m), ∑ z : Fin m → Sf Λ,
              ((m.factorial : ℂ)⁻¹ * (Perm.sign σ • ∏ i, (Matrix.of fun i j => v j (z i)) (σ i) i))
                • psiPow z
            = ∑ σ : Perm (Fin m), ∑ w : Fin m → Sf Λ,
                ((m.factorial : ℂ)⁻¹ * ∏ i, v i (w i)) • psiPow w := by
              refine Finset.sum_congr rfl fun σ _ => ?_
              let e : (Fin m → Sf Λ) ≃ (Fin m → Sf Λ) :=
                { toFun := fun z => z ∘ σ, invFun := fun w => w ∘ σ.symm,
                  left_inv := fun z => by ext i <;> simp,
                  right_inv := fun w => by ext i <;> simp }
              refine Fintype.sum_equiv e _ _ fun z => ?_
              simp only [e, Equiv.coe_fn_mk, psiPow_perm, Matrix.of_apply, smul_smul,
                Function.comp_apply]
              rw [Units.smul_def, ← Int.cast_smul_eq_zsmul ℂ, smul_eq_mul]
              congr 1; ring
          _ = ∑ w : Fin m → Sf Λ, (∏ i, v i (w i)) • psiPow w := by
              rw [Finset.sum_const, Finset.card_univ, Fintype.card_perm, Fintype.card_fin,
                Finset.smul_sum]
              refine Finset.sum_congr rfl fun w _ => ?_
              rw [← Nat.cast_smul_eq_nsmul ℂ, smul_smul, ← mul_assoc,
                mul_inv_cancel₀ (Nat.cast_ne_zero.2 (Nat.factorial_ne_zero m)), one_mul]
      · intro n _ hn
        exact Finset.sum_eq_zero fun z _ => by
          rw [coeff_ιMulti_of_ne _ _ hn, mul_zero, zero_smul]

/-- A family `G` of coefficients is antisymmetric. -/
def Antisymm (G : ∀ n, (Fin n → Sf Λ) → ℂ) : Prop :=
  ∀ n (z : Fin n → Sf Λ) (σ : Perm (Fin n)), G n (z ∘ σ) = Perm.sign σ * G n z

/-- Uniqueness in `e:Fzsum`: if `F = ∑_{|z| ≤ K} (1/z!) G_z ψ^z` with `G` antisymmetric,
then `G_z = F_z` for `|z| ≤ K`. -/
theorem coeff_eq_of_antisymm (G : ∀ n, (Fin n → Sf Λ) → ℂ) (hG : Antisymm G) (K : ℕ)
    {m : ℕ} (hm : m ≤ K) (w : Fin m → Sf Λ) :
    coeff (∑ n ∈ Finset.range (K + 1), ∑ z : Fin n → Sf Λ,
      ((n.factorial : ℂ)⁻¹ * G n z) • psiPow z) w = G m w := by
  rw [coeff_sum, Finset.sum_eq_single_of_mem m (Finset.mem_range.2 (by omega))]
  · rw [coeff_sum_psiPow]
    simp only [hG m w]
    rw [Finset.sum_congr rfl fun σ _ => show (Perm.sign σ : ℂ) *
      ((m.factorial : ℂ)⁻¹ * (Perm.sign σ * G m w)) = (m.factorial : ℂ)⁻¹ * G m w by
        rw [← mul_assoc, mul_comm (Perm.sign σ : ℂ), mul_assoc, ← mul_assoc (Perm.sign σ : ℂ),
          ← Int.cast_mul, ← Units.val_mul, Int.units_mul_self]; simp]
    rw [Finset.sum_const, Finset.card_univ, Fintype.card_perm, Fintype.card_fin, nsmul_eq_mul]
    have : (m.factorial : ℂ) ≠ 0 := Nat.cast_ne_zero.2 (Nat.factorial_ne_zero m)
    field_simp
  · intro n _ hn; exact coeff_sum_psiPow_of_ne _ _ (Ne.symm hn)

/-- `F` is determined by its coefficients. -/
theorem ext_coeff {F G : N Λ} (h : ∀ n (z : Fin n → Sf Λ), coeff F z = coeff G z) : F = G := by
  conv_lhs => rw [sum_coeff F]
  conv_rhs => rw [sum_coeff G]
  simp only [h]

end

end Grassmann
