/-! ## 2. Grassmann Gaussian integration -/

section Gaussian

variable {Λ : Type*} [DecidableEq Λ] [Fintype Λ]

-- inclusions `𝒩(X) ⊆ 𝒩(X')`
example {X X' : Set Λ} (h : X ⊆ X') : NX X ≤ NX X' := NX_mono h

-- (e:theta-def)  `θ ψ_x = ψ_x + ζ_x`, `θ ψ̄_x = ψ̄_x + ζ̄_x`
example (a : Sf Λ) : theta (ψ a) = ψ (Sum.inl a.1, a.2) + ψ (Sum.inr a.1, a.2) := theta_psi a

-- `𝔼_C F = (det C) ∫ ∂_ζ ∂_ζ̄ e^{-(ζ, C^{-1} ζ̄)} F` for positive definite `C`
example (C : Matrix Λ Λ ℝ) (hC : C.PosDef) (F : N (Λ ⊕ Λ)) :
    EC C F = (C.det : ℂ) • proj (berezinζ (IsNilpotent.exp (-quadζ C⁻¹) * F)) :=
  EC_eq_berezin_of_posDef C hC F

-- (e:fWick)  `𝔼_C θ F = e^{ℒ_C} F`, `ℒ_C = ∑_{x,y} C_{xy} ∂_{ψ_y} ∂_{ψ̄_x}`
example (C : Matrix Λ Λ ℝ) (F : N Λ) : EC C (theta F) = IsNilpotent.exp (Lop C) F :=
  EC_theta C F
example (C : Matrix Λ Λ ℝ) (F : N Λ) :
    Lop C F = ∑ x, ∑ y, (C x y : ℂ) • D (y, 1) (D (x, -1) F) := Lop_apply C F

-- (e:E-semigroup)  `𝔼_{C_2} θ ∘ 𝔼_{C_1} θ = 𝔼_{C_1 + C_2} θ`
example (C₁ C₂ : Matrix Λ Λ ℝ) (F : N Λ) :
    EC C₂ (theta (EC C₁ (theta F))) = EC (C₁ + C₂) (theta F) := EC_theta_comp C₁ C₂ F

-- `𝔼_C θ ψ̄_x ψ_y = ψ̄_x ψ_y + C_{xy}`
example (C : Matrix Λ Λ ℝ) (x y : Λ) :
    EC C (theta (psibar x * psi y)) = psibar x * psi y + algebraMap ℂ (N Λ) (C x y : ℂ) :=
  EC_theta_psibar_psi C x y

-- factorisation for covariances vanishing between `X_1` and `X_2`
example (C : Matrix Λ Λ ℝ) {X₁ X₂ : Set Λ} (hX : Disjoint X₁ X₂)
    (hC : ∀ x ∈ X₁, ∀ y ∈ X₂, C x y = 0 ∧ C y x = 0) {F₁ F₂ : N Λ} (hF₁ : F₁ ∈ NX X₁)
    (hF₂ : F₂ ∈ NX X₂) :
    EC C (theta (F₁ * F₂)) = EC C (theta F₁) * EC C (theta F₂) :=
  EC_theta_mul_of_disjoint C hX hC hF₁ hF₂

end Gaussian

-- the finite range consequence on the torus
example {d n : ℕ} [NeZero n] (C : Matrix (Torus d n) (Torus d n) ℝ) {R : ℝ} (hR : 0 ≤ R)
    (hC : ∀ x y, R ≤ supNorm (x - y) → C x y = 0) {X₁ X₂ : Set (Torus d n)}
    (hX : ∀ x ∈ X₁, ∀ y ∈ X₂, R < supNorm (x - y)) {F₁ F₂ : N (Torus d n)} (hF₁ : F₁ ∈ NX X₁)
    (hF₂ : F₂ ∈ NX X₂) :
    EC C (theta (F₁ * F₂)) = EC C (theta F₁) * EC C (theta F₂) :=
  EC_theta_mul_of_finiteRange C hR hC hX hF₁ hF₂

/-! ## 3. Coefficients and norms -/

section Norms

variable {Λ : Type*} [DecidableEq Λ] [Fintype Λ]

-- (e:Fzsum)  `F = ∑_z (1/z!) F_z ψ^z`, with antisymmetric `F_z`, unique among antisymmetric
-- families, vanishing for `|z| > 2|Λ|`
example (F : N Λ) : F = ∑ n ∈ Finset.range (Nf Λ + 1), ∑ z : Fin n → Sf Λ,
    ((n.factorial : ℂ)⁻¹ * coeff F z) • psiPow z := sum_coeff F
example (F : N Λ) {n : ℕ} (z : Fin n → Sf Λ) (σ : Equiv.Perm (Fin n)) :
    coeff F (z ∘ σ) = (Equiv.Perm.sign σ : ℂ) * coeff F z := coeff_perm F z σ
example (G : ∀ n, (Fin n → Sf Λ) → ℂ) (hG : Antisymm G) (K : ℕ) {m : ℕ} (hm : m ≤ K)
    (w : Fin m → Sf Λ) :
    coeff (∑ n ∈ Finset.range (K + 1), ∑ z : Fin n → Sf Λ,
      ((n.factorial : ℂ)⁻¹ * G n z) • psiPow z) w = G m w := coeff_eq_of_antisymm G hG K hm w
example (F : N Λ) {n : ℕ} (z : Fin n → Sf Λ) (hn : Nf Λ < n) : coeff F z = 0 :=
  coeff_eq_zero_of_lt F z hn
example : Nf Λ = 2 * Fintype.card Λ := by simp [Nf, Fintype.card_prod, mul_comm]

variable {E : Type*} [Fintype E] [DecidableEq E] [AddAction (E → ℕ) Λ] {p : ℕ} {h ℓ : ℝ}

-- the discrete derivative is the product of elementary differences
example (i : Fin 1) (e : E) (f : (Fin 1 → Sf Λ) → ℂ) (z : Fin 1 → Sf Λ) :
    nab (Pi.single i (Pi.single e 1)) f z =
      f (Function.update z i (sh (Pi.single e 1) (z i))) - f z := by
  rw [nabla_single sh (fun _ => sh_zero _) sh_add]; rfl

-- (e:T-product)
example (hh : 0 < h) (hℓ : 0 < ℓ) (F₁ F₂ : N Λ) :
    tNorm E p h ℓ (F₁ * F₂) ≤ tNorm E p h ℓ F₁ * tNorm E p h ℓ F₂ := tNorm_mul_le hh hℓ F₁ F₂

-- (e:T-monotone)  both inequalities: `h = L^j ≤ h' = L^{j+1}`, `ℓ ≤ ℓ'`
example {h' ℓ' : ℝ} (hh : 0 ≤ h) (hhh : h ≤ h') (hℓ : 0 < ℓ) (hℓℓ : ℓ ≤ ℓ') (F : N Λ) :
    tNorm E p h' ℓ F ≤ tNorm E p h ℓ' F := tNorm_mono hh hhh hℓ hℓℓ F

-- examples: `‖ψ_x‖ = ℓ`, `‖(∇_e ψ)_x‖ ≤ ℓ L^{-j}`, `‖ψ_x ψ̄_x ψ_{x+e} ψ̄_{x+e}‖ ≤ ℓ^4 L^{-2j}`
example (hh : 0 < h) (hℓ : 0 < ℓ) (x : Λ) : tNorm E p h ℓ (psi x) = ENNReal.ofReal ℓ :=
  tNorm_psi hh hℓ x
example (hp : 1 ≤ p) (hh : 0 < h) (hℓ : 0 < ℓ) (e : E) (a : Sf Λ) :
    tNorm E p h ℓ (dψ e a) ≤ ENNReal.ofReal (ℓ * h⁻¹) := tNorm_dψ_le hp hh hℓ e a
example (hp : 1 ≤ p) (hh : 0 < h) (hℓ : 0 < ℓ) (e : E) (x : Λ) :
    tNorm E p h ℓ
        (psi x * psibar x * (ψ (sh (Pi.single e 1) (x, 1)) * ψ (sh (Pi.single e 1) (x, -1)))) ≤
      ENNReal.ofReal (ℓ ^ 4 * h⁻¹ ^ 2) := tNorm_four_le hp hh hℓ e x

-- (e:theta-bd)
example (hh : 0 < h) (hℓ : 0 < ℓ) (F : N Λ) :
    tNorm E p h ℓ (theta F) ≤ tNorm E p h (2 * ℓ) F := tNorm_theta_le hh hℓ F

-- (e:E-contract2), (e:E-contract)
example (hh : 0 < h) (hℓ : 0 < ℓ) {C : Matrix Λ Λ ℝ} (hC : C.PosSemidef)
    (hCn : covNorm E p h ℓ C ≤ 1) (F : N (Λ ⊕ Λ)) :
    tNorm E p h ℓ (EC C F) ≤ tNorm E p h ℓ F := tNorm_EC_le hh hℓ hC hCn F
example (hh : 0 < h) (hℓ : 0 < ℓ) {C : Matrix Λ Λ ℝ} (hC : C.PosSemidef)
    (hCn : covNorm E p h ℓ C ≤ 1) (F : N Λ) :
    tNorm E p h ℓ (EC C (theta F)) ≤ tNorm E p h (2 * ℓ) F := tNorm_EC_theta_le hh hℓ hC hCn F

end Norms

/-! ## 4. The torus: `e:Cleq1` and `e:normcontract` -/

section Torus

variable {d n : ℕ} [NeZero n]

example (e : Dir d) (x : Torus d n) : (Pi.single e 1 : Dir d → ℕ) +ᵥ x = x + dirVec e :=
  single_vadd e x

-- (e:Cleq1) from (e:C-bd)
example {L ℓ₀ K : ℝ} (hL : 1 ≤ L) (hℓ₀ : 0 < ℓ₀) (hK : 0 ≤ K) (j : ℕ)
    {C : Matrix (Torus d n) (Torus d n) ℝ}
    (hbd : ∀ α₁ α₂ : Dir d → ℕ, mabs α₁ ≤ pPhi d → mabs α₂ ≤ pPhi d → ∀ x y,
      |nabC C α₁ α₂ x y| ≤ K * L ^ (-(((d : ℝ) - 2 + mabs α₁ + mabs α₂) * j)))
    (hℓ₀K : K * L ^ ((d : ℝ) - 2 + 2 * pPhi d) ≤ ℓ₀ ^ 2) :
    covNormj L (j + 1) (ellj d L ℓ₀ (j + 1)) C ≤ 1 := covNormj_le_one hL hℓ₀ hK j hbd hℓ₀K

-- (e:normcontract)
example (hd : 3 ≤ d) {L ℓ₀ : ℝ} (hL : 4 ≤ L) (hℓ₀ : 0 < ℓ₀) (j : ℕ) (F : N (Torus d n)) :
    Tj d L (j + 1) (ellj d L ℓ₀ (j + 1)) F ≤ Tj d L (j + 1) (2 * ellj d L ℓ₀ (j + 1)) F ∧
      Tj d L (j + 1) (2 * ellj d L ℓ₀ (j + 1)) F ≤ Tj d L j (ellj d L ℓ₀ j) F :=
  Tj_succ_le hd hL hℓ₀ j F
example (hd : 3 ≤ d) {L ℓ₀ : ℝ} (hL : 4 ≤ L) (hℓ₀ : 0 < ℓ₀) (j : ℕ)
    {C : Matrix (Torus d n) (Torus d n) ℝ} (hC : C.PosSemidef)
    (hCn : covNormj L (j + 1) (ellj d L ℓ₀ (j + 1)) C ≤ 1) (F : N (Torus d n)) :
    Tj d L (j + 1) (ellj d L ℓ₀ (j + 1)) (EC C (theta F)) ≤ Tj d L j (ellj d L ℓ₀ j) F :=
  Tj_EC_theta_le hd hL hℓ₀ j hC hCn F

end Torus

