import Grassmann.Coeff

/-!
# Grassmann Gaussian integration (Section `sec:grassm-gauss-integr`)

* `NX X` is the subalgebra `𝒩(X) ⊆ 𝒩(Λ)` generated by `ψ_x, ψ̄_x`, `x ∈ X`; `NX_mono` gives the
  inclusions `𝒩(X) ⊆ 𝒩(X')`.
* The doubled algebra `𝒩(Λ ⊔ Λ)` is `N (Λ ⊕ Λ)`: its generators `ψ_{(inl x, σ)}` are the
  `ψ_x, ψ̄_x` and its generators `ψ_{(inr x, σ)}` are the `ζ_x, ζ̄_x`.
* `theta` is the doubling homomorphism `θ` of `e:theta-def` (`theta_psi`).
* `Lop C = ℒ_C = ∑_{x,y} C_{xy} ∂_{ψ_y} ∂_{ψ̄_x}`; `Lζ C` is the same operator acting on the
  `ζ` variables of the doubled algebra.
* `EC C F = 𝔼_C F`: the Gaussian expectation acting on the `ζ, ζ̄` variables, defined for every
  matrix `C` as `F ↦ (e^{ℒ_C^ζ} F)|_{ζ = 0}`.  `Grassmann.Berezin` shows that for invertible `C`
  this is `(det C) ∫ ∂_ζ ∂_ζ̄ e^{-(ζ, C^{-1} ζ̄)} F`, the definition used in `h02rg.tex` for
  positive definite `C`.
* `EC_theta` is `e:fWick`: `𝔼_C θ F = e^{ℒ_C} F`; `EC_theta_comp` is `e:E-semigroup`;
  `EC_theta_psibar_psi` is the moment `𝔼_C θ ψ̄_x ψ_y = ψ̄_x ψ_y + C_{xy}`; and
  `EC_theta_mul_of_disjoint` is the factorisation for covariances vanishing between `X_1`
  and `X_2` (the consequence of the finite range property).
-/

namespace Grassmann

noncomputable section

open CliffordAlgebra ExteriorAlgebra Finset

/-! ### General facts -/

section General

variable {M M' : Type*} [AddCommGroup M] [Module ℂ M] [AddCommGroup M'] [Module ℂ M']

theorem inv'_map (f : M →ₗ[ℂ] M') (x : ExteriorAlgebra ℂ M) :
    inv' (ExteriorAlgebra.map f x) = ExteriorAlgebra.map f (inv' x) := by
  induction x using CliffordAlgebra.induction with
  | algebraMap r => simp
  | ι m => simp [inv'_ι, ExteriorAlgebra.map_apply_ι]
  | mul a b ha hb => rw [map_mul, map_mul, ha, hb, map_mul, map_mul]
  | add a b ha hb => rw [map_add, map_add, ha, hb, map_add, map_add]

/-- The chain rule for the contraction: `∂_φ (map f x) = map f (∂_{φ ∘ f} x)`. -/
theorem contractLeft_map (f : M →ₗ[ℂ] M') (φ : Module.Dual ℂ M') (x : ExteriorAlgebra ℂ M) :
    contractLeft φ (ExteriorAlgebra.map f x) = ExteriorAlgebra.map f (contractLeft (φ ∘ₗ f) x) := by
  induction x using CliffordAlgebra.induction with
  | algebraMap r => simp
  | ι m => simp [ExteriorAlgebra.map_apply_ι, contractLeft_ι]
  | mul a b ha hb =>
    rw [map_mul, contractLeft_mul, contractLeft_mul, ha, hb, map_add, map_mul, map_mul, inv'_map]
  | add a b ha hb => rw [map_add, map_add, ha, hb, map_add, map_add]

end General

variable {I : Type*} [DecidableEq I]

/-- `D a` is an odd derivation. -/
theorem D_mul (a : Sf I) (x y : N I) : D a (x * y) = D a x * y + inv' x * D a y :=
  contractLeft_mul _ x y

theorem D_comm (a b : Sf I) (x : N I) : D a (D b x) = -D b (D a x) := contractLeft_comm _ _ _

theorem D_D (a : Sf I) (x : N I) : D a (D a x) = 0 := contractLeft_contractLeft _ _

theorem D_ψ (a b : Sf I) : D a (ψ b) = if a = b then 1 else 0 := by
  simp only [D, ψ, ev, contractLeft_ι, LinearMap.proj_apply, Pi.single_apply]
  split_ifs <;> simp

@[simp] theorem D_one (a : Sf I) : D a (1 : N I) = 0 := by simp [D]

theorem D_algebraMap (a : Sf I) (r : ℂ) : D a (algebraMap ℂ (N I) r) = 0 := by simp [D]

theorem D_inv' (a : Sf I) (x : N I) : D a (inv' x) = -inv' (D a x) := contractLeft_inv' _ _

@[simp] theorem inv'_ψ (a : Sf I) : inv' (ψ a : N I) = -ψ a := inv'_ι _

/-- The product of two derivatives commutes with every derivative. -/
theorem DD_comm (a b c : Sf I) (x : N I) : D c (D a (D b x)) = D a (D b (D c x)) := by
  rw [D_comm c a, D_comm c b, map_neg, neg_neg]

/-! ### Degree and nilpotency -/

/-- `x` has degree at most `n`: all coefficients of order `> n` vanish. -/
def DegLe (n : ℕ) (x : N I) : Prop := ∀ m (z : Fin m → Sf I), n < m → coeff x z = 0

theorem coeff_D (a : Sf I) (x : N I) {m : ℕ} (z : Fin m → Sf I) :
    coeff (D a x) z = coeff x (Fin.cons a z) := by
  simp only [coeff, Dseq, contr_succ]
  congr 2

theorem DegLe.D {n : ℕ} {x : N I} (hx : DegLe (n + 1) x) (a : Sf I) : DegLe n (D a x) :=
  fun m z hm => by rw [coeff_D]; exact hx _ _ (by omega)

theorem DegLe.mono {n n' : ℕ} {x : N I} (hx : DegLe n x) (h : n ≤ n') : DegLe n' x :=
  fun m z hm => hx m z (by omega)

theorem DegLe.add {n : ℕ} {x y : N I} (hx : DegLe n x) (hy : DegLe n y) : DegLe n (x + y) :=
  fun m z hm => by rw [coeff_add, hx m z hm, hy m z hm, add_zero]

theorem DegLe.smul {n : ℕ} {x : N I} (hx : DegLe n x) (r : ℂ) : DegLe n (r • x) :=
  fun m z hm => by rw [coeff_smul, hx m z hm, mul_zero]

theorem DegLe.zero (n : ℕ) : DegLe n (0 : N I) := fun m z _ => coeff_zero z

theorem DegLe.sum {ι : Type*} (s : Finset ι) {n : ℕ} {x : ι → N I} (hx : ∀ i ∈ s, DegLe n (x i)) :
    DegLe n (∑ i ∈ s, x i) := by
  induction s using Finset.cons_induction with
  | empty => simpa using DegLe.zero n
  | cons i s hi ih =>
    rw [sum_cons]
    exact (hx i (mem_cons_self i s)).add (ih fun j hj => hx j (mem_cons_of_mem hj))

theorem D_eq_zero_of_degLe_zero [Fintype I] {x : N I} (hx : DegLe 0 x) (a : Sf I) : D a x = 0 :=
  ext_coeff fun m z => by rw [coeff_D, hx _ _ (by omega), coeff_zero]

theorem degLe_Nf [Fintype I] (x : N I) : DegLe (Nf I) x := fun _ z hm => coeff_eq_zero_of_lt x z hm

/-- An operator lowering the degree is nilpotent. -/
theorem pow_eq_zero_of_degLe [Fintype I] (T : Module.End ℂ (N I))
    (hT : ∀ n x, DegLe (n + 1) x → DegLe n (T x)) (hT0 : ∀ x, DegLe 0 x → T x = 0) :
    T ^ (Nf I + 1) = 0 := by
  refine LinearMap.ext fun x => ?_
  have key : ∀ k ≤ Nf I, DegLe (Nf I - k) ((T ^ k) x) := by
    intro k hk
    induction k with
    | zero => simpa using degLe_Nf x
    | succ k ih =>
      rw [pow_succ', Module.End.mul_apply]
      exact hT _ _ (by rw [show Nf I - k = Nf I - (k + 1) + 1 by omega] at ih; exact ih (by omega))
  rw [pow_succ', Module.End.mul_apply, hT0 _ (by simpa using key (Nf I) le_rfl)]
  rfl

theorem isNilpotent_of_degLe [Fintype I] (T : Module.End ℂ (N I))
    (hT : ∀ n x, DegLe (n + 1) x → DegLe n (T x)) (hT0 : ∀ x, DegLe 0 x → T x = 0) :
    IsNilpotent T := ⟨_, pow_eq_zero_of_degLe T hT hT0⟩

/-- `∂_b ∂_a` lowers the degree by `2`. -/
theorem DD_degLe [Fintype I] {n : ℕ} {x : N I} (hx : DegLe (n + 1) x) (a b : Sf I) : DegLe n (D b (D a x)) := by
  rcases n with _ | n
  · rw [D_eq_zero_of_degLe_zero (hx.D a) b]; exact DegLe.zero 0
  · exact ((hx.D a).D b).mono (by omega)

/-! ### The operator `ℒ_C` -/

/-- `ℒ_C = ∑_{x,y} C_{xy} ∂_{ψ_y} ∂_{ψ̄_x}` (the derivative `∂_{ψ̄_x}` acts first). -/
def Lop [Fintype I] (C : Matrix I I ℝ) : Module.End ℂ (N I) :=
  ∑ x, ∑ y, (C x y : ℂ) • (D (y, 1) ∘ₗ D (x, -1))

theorem Lop_apply [Fintype I] (C : Matrix I I ℝ) (F : N I) :
    Lop C F = ∑ x, ∑ y, (C x y : ℂ) • D (y, 1) (D (x, -1) F) := by
  simp [Lop, LinearMap.sum_apply]

theorem Lop_add [Fintype I] (C₁ C₂ : Matrix I I ℝ) : Lop (C₁ + C₂) = Lop C₁ + Lop C₂ := by
  simp only [Lop, Matrix.add_apply, Complex.ofReal_add, add_smul, sum_add_distrib]

theorem DD_commute (a b c d : Sf I) : Commute (D b ∘ₗ D a) (D d ∘ₗ D c) := by
  refine LinearMap.ext fun F => ?_
  simp only [Module.End.mul_apply, LinearMap.comp_apply]
  rw [DD_comm b a c F, DD_comm b a d]

theorem Lop_commute [Fintype I] (C₁ C₂ : Matrix I I ℝ) : Commute (Lop C₁) (Lop C₂) :=
  Commute.sum_left _ _ _ fun x _ => Commute.sum_left _ _ _ fun y _ =>
    Commute.sum_right _ _ _ fun x' _ => Commute.sum_right _ _ _ fun y' _ =>
      ((DD_commute _ _ _ _).smul_left _).smul_right _

theorem Lop_degLe [Fintype I] (C : Matrix I I ℝ) {n : ℕ} {x : N I} (hx : DegLe (n + 1) x) :
    DegLe n (Lop C x) := by
  rw [Lop_apply]
  exact DegLe.sum _ fun a _ => DegLe.sum _ fun b _ => (DD_degLe hx _ _).smul _

theorem Lop_degLe_zero [Fintype I] (C : Matrix I I ℝ) {x : N I} (hx : DegLe 0 x) : Lop C x = 0 := by
  rw [Lop_apply]
  exact sum_eq_zero fun a _ => sum_eq_zero fun b _ => by
    rw [D_eq_zero_of_degLe_zero hx, map_zero, smul_zero]

theorem Lop_pow_eq_zero [Fintype I] (C : Matrix I I ℝ) : Lop C ^ (Nf I + 1) = 0 :=
  pow_eq_zero_of_degLe _ (fun _ _ hx => Lop_degLe C hx) fun _ hx => Lop_degLe_zero C hx

theorem Lop_isNilpotent [Fintype I] (C : Matrix I I ℝ) : IsNilpotent (Lop C) :=
  ⟨_, Lop_pow_eq_zero C⟩

/-- `e^{ℒ_C}`. -/
abbrev expL [Fintype I] (C : Matrix I I ℝ) : Module.End ℂ (N I) := IsNilpotent.exp (Lop C)

/-! ### The doubled algebra -/

variable {Λ : Type*} [DecidableEq Λ]

/-- `ψ_x, ψ̄_x ↦ ψ_x + ζ_x, ψ̄_x + ζ̄_x` on generators. -/
def thetaV : V Λ →ₗ[ℂ] V (Λ ⊕ Λ) where
  toFun v b := v (Sum.elim id id b.1, b.2)
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

/-- Inclusion of the `ψ` variables. -/
def inlV : V Λ →ₗ[ℂ] V (Λ ⊕ Λ) where
  toFun v b := Sum.elim (fun x => v (x, b.2)) (fun _ => 0) b.1
  map_add' v w := by ext ⟨b, σ⟩; cases b <;> simp
  map_smul' c v := by ext ⟨b, σ⟩; cases b <;> simp

/-- Inclusion of the `ζ` variables. -/
def inrV : V Λ →ₗ[ℂ] V (Λ ⊕ Λ) where
  toFun v b := Sum.elim (fun _ => 0) (fun x => v (x, b.2)) b.1
  map_add' v w := by ext ⟨b, σ⟩; cases b <;> simp
  map_smul' c v := by ext ⟨b, σ⟩; cases b <;> simp

/-- Setting `ζ = 0`. -/
def projV : V (Λ ⊕ Λ) →ₗ[ℂ] V Λ where
  toFun w a := w (Sum.inl a.1, a.2)
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

/-- The doubling homomorphism `θ : 𝒩(Λ) → 𝒩(Λ ⊔ Λ)` (`e:theta-def`). -/
def theta : N Λ →ₐ[ℂ] N (Λ ⊕ Λ) := ExteriorAlgebra.map thetaV

/-- The inclusion `𝒩(Λ) → 𝒩(Λ ⊔ Λ)` onto the `ψ` variables. -/
def incl : N Λ →ₐ[ℂ] N (Λ ⊕ Λ) := ExteriorAlgebra.map inlV

/-- The inclusion `𝒩(Λ) → 𝒩(Λ ⊔ Λ)` onto the `ζ` variables, `ψ ↦ ζ`. -/
def inclζ : N Λ →ₐ[ℂ] N (Λ ⊕ Λ) := ExteriorAlgebra.map inrV

/-- `F ↦ F|_{ζ = 0}`. -/
def proj : N (Λ ⊕ Λ) →ₐ[ℂ] N Λ := ExteriorAlgebra.map projV

/-- The generators `ζ_a` of the doubled algebra. -/
abbrev ζ (a : Sf Λ) : N (Λ ⊕ Λ) := ψ (Sum.inr a.1, a.2)

/-- The generators `ψ_a` of the doubled algebra. -/
abbrev ψ₁ (a : Sf Λ) : N (Λ ⊕ Λ) := ψ (Sum.inl a.1, a.2)

theorem thetaV_ev (a : Sf Λ) : thetaV (ev a) = ev (Sum.inl a.1, a.2) + ev (Sum.inr a.1, a.2) := by
  ext ⟨b, σ⟩
  cases b <;> simp [thetaV, ev, Pi.single_apply, Prod.ext_iff]

/-- `e:theta-def`: `θ ψ_a = ψ_a + ζ_a` for `a ∈ Λ_f`, i.e. `θ ψ_x = ψ_x + ζ_x` and
`θ ψ̄_x = ψ̄_x + ζ̄_x`. -/
theorem theta_psi (a : Sf Λ) : theta (ψ a) = ψ₁ a + ζ a := by
  rw [theta, ψ, ExteriorAlgebra.map_apply_ι, thetaV_ev, map_add]; rfl

theorem incl_psi (a : Sf Λ) : incl (ψ a) = ψ₁ a := by
  rw [incl, ψ, ExteriorAlgebra.map_apply_ι]; congr 1
  ext ⟨b, σ⟩; cases b <;> simp [inlV, ev, Pi.single_apply, Prod.ext_iff]

theorem inclζ_psi (a : Sf Λ) : inclζ (ψ a) = ζ a := by
  rw [inclζ, ψ, ExteriorAlgebra.map_apply_ι]; congr 1
  ext ⟨b, σ⟩; cases b <;> simp [inrV, ev, Pi.single_apply, Prod.ext_iff]

theorem proj_ψ₁ (a : Sf Λ) : proj (ψ₁ a) = ψ a := by
  simp only [proj, ψ₁, ψ, ExteriorAlgebra.map_apply_ι]; congr 1
  ext ⟨b, σ⟩; simp [projV, ev, Pi.single_apply, Prod.ext_iff]

theorem proj_ζ (a : Sf Λ) : proj (ζ a) = 0 := by
  simp only [proj, ζ, ψ, ExteriorAlgebra.map_apply_ι]
  convert (ExteriorAlgebra.ι ℂ).map_zero

theorem proj_theta (F : N Λ) : proj (theta F) = F := by
  rw [proj, theta, ← AlgHom.comp_apply, ExteriorAlgebra.map_comp_map]
  have : projV ∘ₗ thetaV = (LinearMap.id : V Λ →ₗ[ℂ] V Λ) := by
    ext v ⟨x, σ⟩; simp [projV, thetaV]
  rw [this, ExteriorAlgebra.map_id]; rfl

theorem proj_incl (F : N Λ) : proj (incl F) = F := by
  rw [proj, incl, ← AlgHom.comp_apply, ExteriorAlgebra.map_comp_map]
  have : projV ∘ₗ inlV = (LinearMap.id : V Λ →ₗ[ℂ] V Λ) := by
    ext v ⟨x, σ⟩; simp [projV, inlV]
  rw [this, ExteriorAlgebra.map_id]; rfl

/-- `(F)|_{ζ=0}` of a `ζ`-only element is its constant term. -/
theorem proj_inclζ (F : N Λ) : proj (inclζ F) = algebraMap ℂ (N Λ) (ε F) := by
  rw [proj, inclζ, ← AlgHom.comp_apply, ExteriorAlgebra.map_comp_map]
  have : projV ∘ₗ inrV = (0 : V Λ →ₗ[ℂ] V Λ) := by
    ext v ⟨x, σ⟩; simp [projV, inrV]
  rw [this]
  induction F using CliffordAlgebra.induction with
  | algebraMap r => simp
  | ι m => simp [ExteriorAlgebra.map_apply_ι]
  | mul a b ha hb => rw [map_mul, ha, hb, map_mul, map_mul]
  | add a b ha hb => rw [map_add, ha, hb, map_add, map_add]

theorem coord_inr_thetaV (a : Sf Λ) : coord (Sum.inr a.1, a.2) ∘ₗ thetaV = coord a := by
  ext v; simp [thetaV]

/-- `∂_{ζ_a} θ = θ ∂_{ψ_a}`. -/
theorem Dζ_theta (a : Sf Λ) (F : N Λ) : D (Sum.inr a.1, a.2) (theta F) = theta (D a F) := by
  rw [D, theta, contractLeft_map, coord_inr_thetaV]; rfl

/-- `ℒ_C^ζ = ∑_{x,y} C_{xy} ∂_{ζ_y} ∂_{ζ̄_x}` on the doubled algebra. -/
def Lζ [Fintype Λ] (C : Matrix Λ Λ ℝ) : Module.End ℂ (N (Λ ⊕ Λ)) :=
  ∑ x, ∑ y, (C x y : ℂ) • (D (Sum.inr y, 1) ∘ₗ D (Sum.inr x, -1))

theorem Lζ_apply [Fintype Λ] (C : Matrix Λ Λ ℝ) (F : N (Λ ⊕ Λ)) :
    Lζ C F = ∑ x, ∑ y, (C x y : ℂ) • D (Sum.inr y, 1) (D (Sum.inr x, -1) F) := by
  simp [Lζ, LinearMap.sum_apply]

theorem Lζ_isNilpotent [Fintype Λ] (C : Matrix Λ Λ ℝ) : IsNilpotent (Lζ C) := by
  refine isNilpotent_of_degLe _ (fun n x hx => ?_) fun x hx => ?_
  · rw [Lζ_apply]
    exact DegLe.sum _ fun a _ => DegLe.sum _ fun b _ => (DD_degLe hx _ _).smul _
  · rw [Lζ_apply]
    exact sum_eq_zero fun a _ => sum_eq_zero fun b _ => by
      rw [D_eq_zero_of_degLe_zero hx, map_zero, smul_zero]

theorem Lζ_theta [Fintype Λ] (C : Matrix Λ Λ ℝ) :
    Lζ C ∘ₗ theta.toLinearMap = theta.toLinearMap ∘ₗ Lop C := by
  refine LinearMap.ext fun F => ?_
  simp only [LinearMap.comp_apply, AlgHom.toLinearMap_apply, Lζ_apply, Lop_apply, map_sum,
    map_smul]
  refine sum_congr rfl fun x _ => sum_congr rfl fun y _ => ?_
  rw [show ((Sum.inr x, -1) : Sf (Λ ⊕ Λ)) = (Sum.inr (x, (-1 : ℤˣ)).1, (x, (-1 : ℤˣ)).2) from rfl,
    Dζ_theta,
    show ((Sum.inr y, 1) : Sf (Λ ⊕ Λ)) = (Sum.inr (y, (1 : ℤˣ)).1, (y, (1 : ℤˣ)).2) from rfl,
    Dζ_theta]

/-- The Gaussian expectation `𝔼_C : 𝒩(Λ ⊔ Λ) → 𝒩(Λ)`, integrating out `ζ, ζ̄`. -/
def EC [Fintype Λ] (C : Matrix Λ Λ ℝ) : N (Λ ⊕ Λ) →ₗ[ℂ] N Λ :=
  proj.toLinearMap ∘ₗ IsNilpotent.exp (Lζ C)

/-- `e:fWick`: `𝔼_C θ F = e^{ℒ_C} F`. -/
theorem EC_theta [Fintype Λ] (C : Matrix Λ Λ ℝ) (F : N Λ) : EC C (theta F) = expL C F := by
  have h := Module.End.commute_exp_left_of_commute (Lop_isNilpotent C) (Lζ_isNilpotent C)
    (Lζ_theta C)
  have := LinearMap.congr_fun h F
  simp only [LinearMap.comp_apply, AlgHom.toLinearMap_apply] at this
  rw [EC, LinearMap.comp_apply, this, AlgHom.toLinearMap_apply, proj_theta]

/-- `e:E-semigroup`: `𝔼_{C_2} θ ∘ 𝔼_{C_1} θ = 𝔼_{C_1 + C_2} θ`. -/
theorem EC_theta_comp [Fintype Λ] (C₁ C₂ : Matrix Λ Λ ℝ) (F : N Λ) :
    EC C₂ (theta (EC C₁ (theta F))) = EC (C₁ + C₂) (theta F) := by
  rw [EC_theta, EC_theta, EC_theta]
  unfold expL
  rw [Lop_add, add_comm,
    IsNilpotent.exp_add_of_commute (Lop_commute C₂ C₁) (Lop_isNilpotent C₂) (Lop_isNilpotent C₁)]
  rfl

/-- The moment `𝔼_C θ ψ̄_x ψ_y = ψ̄_x ψ_y + C_{xy}`. -/
theorem EC_theta_psibar_psi [Fintype Λ] (C : Matrix Λ Λ ℝ) (x y : Λ) :
    EC C (theta (psibar x * psi y)) = psibar x * psi y + algebraMap ℂ (N Λ) (C x y : ℂ) := by
  have e1 : ∀ a, D (a, -1) (psibar x * psi y) = if a = x then psi y else 0 := by
    intro a
    have hne : ((a, -1) : Sf Λ) ≠ (y, 1) := by simp [Prod.ext_iff]
    rw [D_mul, psibar, psi, D_ψ, D_ψ, if_neg hne, mul_zero, add_zero]
    by_cases h : a = x
    · subst h; simp
    · rw [if_neg (by simp [Prod.ext_iff, h]), if_neg h, zero_mul]
  have e2 : ∀ b, D (b, 1) (psi y) = if b = y then 1 else 0 := fun b => by
    simp [psi, D_ψ, Prod.ext_iff]
  have hL : Lop C (psibar x * psi y) = algebraMap ℂ (N Λ) (C x y : ℂ) := by
    rw [Lop_apply]
    simp only [e1, apply_ite (D _), map_zero, e2, smul_ite, smul_zero]
    simp [Algebra.algebraMap_eq_smul_one]
  have hk : (Lop C ^ 2) • (psibar x * psi y) = 0 := by
    rw [pow_two, mul_smul, Module.End.smul_def, Module.End.smul_def, hL, Lop_apply]
    simp [D_algebraMap]
  rw [EC_theta]
  have := IsNilpotent.exp_smul_eq_sum hk (Lop_isNilpotent C)
  rw [Module.End.smul_def] at this
  rw [this]
  simp [Finset.sum_range_succ, hL]

/-! ### The subalgebras `𝒩(X)` and factorisation -/

/-- `𝒩(X) ⊆ 𝒩(Λ)`, the subalgebra generated by `ψ_x, ψ̄_x`, `x ∈ X`. -/
def NX (X : Set Λ) : Subalgebra ℂ (N Λ) :=
  Algebra.adjoin ℂ (Set.range fun a : {a : Sf Λ // a.1 ∈ X} => ψ a.1)

/-- The inclusions `𝒩(X) ⊆ 𝒩(X')` for `X ⊆ X'`. -/
theorem NX_mono {X X' : Set Λ} (h : X ⊆ X') : NX X ≤ NX X' := by
  refine Algebra.adjoin_mono ?_
  rintro _ ⟨⟨a, ha⟩, rfl⟩
  exact ⟨⟨a, h ha⟩, rfl⟩

theorem ψ_mem_NX {X : Set Λ} {a : Sf Λ} (ha : a.1 ∈ X) : ψ a ∈ NX X :=
  Algebra.subset_adjoin ⟨⟨a, ha⟩, rfl⟩

theorem inv'_mem_NX {X : Set Λ} {F : N Λ} (hF : F ∈ NX X) : inv' F ∈ NX X := by
  induction hF using Algebra.adjoin_induction with
  | mem x hx =>
    obtain ⟨⟨a, ha⟩, rfl⟩ := hx
    rw [inv'_ψ]; exact neg_mem (ψ_mem_NX ha)
  | algebraMap r => rw [AlgHom.commutes]; exact Subalgebra.algebraMap_mem _ r
  | add x y _ _ hx hy => rw [map_add]; exact add_mem hx hy
  | mul x y _ _ hx hy => rw [map_mul]; exact mul_mem hx hy

theorem D_mem_NX {X : Set Λ} {F : N Λ} (hF : F ∈ NX X) (a : Sf Λ) : D a F ∈ NX X := by
  induction hF using Algebra.adjoin_induction with
  | mem x hx =>
    obtain ⟨⟨b, hb⟩, rfl⟩ := hx
    rw [D_ψ]; split_ifs
    · exact one_mem _
    · exact zero_mem _
  | algebraMap r => rw [D_algebraMap]; exact zero_mem _
  | add x y _ _ hx hy => rw [map_add]; exact add_mem hx hy
  | mul x y hx' _ hx hy =>
    rw [D_mul]; exact add_mem (mul_mem hx (by assumption)) (mul_mem (inv'_mem_NX hx') hy)

/-- `∂_{ψ_a} F = 0` for `F ∈ 𝒩(X)` and `a ∉ X`. -/
theorem D_eq_zero_of_mem_NX {X : Set Λ} {F : N Λ} (hF : F ∈ NX X) {a : Sf Λ} (ha : a.1 ∉ X) :
    D a F = 0 := by
  induction hF using Algebra.adjoin_induction with
  | mem x hx =>
    obtain ⟨⟨b, hb⟩, rfl⟩ := hx
    rw [D_ψ, if_neg]; rintro rfl; exact ha hb
  | algebraMap r => rw [D_algebraMap]
  | add x y _ _ hx hy => rw [map_add, hx, hy, add_zero]
  | mul x y _ _ hx hy => rw [D_mul, hx, hy, zero_mul, mul_zero, add_zero]

variable [Fintype Λ]

theorem Lop_mem_NX (C : Matrix Λ Λ ℝ) {X : Set Λ} {F : N Λ} (hF : F ∈ NX X) :
    Lop C F ∈ NX X := by
  rw [Lop_apply]
  exact Subalgebra.sum_mem _ fun x _ => Subalgebra.sum_mem _ fun y _ =>
    Subalgebra.smul_mem _ (D_mem_NX (D_mem_NX hF _) _) _

theorem Lop_pow_mem_NX (C : Matrix Λ Λ ℝ) {X : Set Λ} {F : N Λ} (hF : F ∈ NX X) (k : ℕ) :
    (Lop C ^ k) F ∈ NX X := by
  induction k with
  | zero => exact hF
  | succ k ih => rw [pow_succ', Module.End.mul_apply]; exact Lop_mem_NX _ ih

theorem expL_apply_eq_sum (C : Matrix Λ Λ ℝ) (F : N Λ) :
    expL C F = ∑ k ∈ range (Nf Λ + 1), ((k.factorial : ℚ)⁻¹ • (Lop C ^ k)) F := by
  rw [expL, IsNilpotent.exp_eq_sum (Lop_pow_eq_zero C), LinearMap.sum_apply]

theorem expL_mem_NX (C : Matrix Λ Λ ℝ) {X : Set Λ} {F : N Λ} (hF : F ∈ NX X) :
    expL C F ∈ NX X := by
  rw [expL_apply_eq_sum]
  refine Subalgebra.sum_mem _ fun k _ => ?_
  rw [LinearMap.smul_apply, ← Rat.cast_smul_eq_qsmul ℂ]
  exact Subalgebra.smul_mem _ (Lop_pow_mem_NX C hF k) _

theorem expL_eq_self (C : Matrix Λ Λ ℝ) {F : N Λ} (hF : Lop C F = 0) : expL C F = F := by
  have h1 : (Lop C ^ 1) • F = 0 := by rw [pow_one]; exact hF
  have := IsNilpotent.exp_smul_eq_sum h1 (Lop_isNilpotent C)
  rw [Module.End.smul_def] at this
  rw [expL, this]; simp

/-- If `ℒ` commutes with right multiplication by `G`, so does `e^{ℒ}`. -/
theorem expL_mul_right (C : Matrix Λ Λ ℝ) (G : N Λ) (h : ∀ H, Lop C (H * G) = Lop C H * G)
    (H : N Λ) : expL C (H * G) = expL C H * G := by
  have := Module.End.commute_exp_left_of_commute (Lop_isNilpotent C) (Lop_isNilpotent C)
    (g := LinearMap.mulRight ℂ G) (LinearMap.ext fun H => by simp [h])
  simpa using LinearMap.congr_fun this H

theorem expL_mul_left (C : Matrix Λ Λ ℝ) (F : N Λ) (h : ∀ G, Lop C (F * G) = F * Lop C G)
    (G : N Λ) : expL C (F * G) = F * expL C G := by
  have := Module.End.commute_exp_left_of_commute (Lop_isNilpotent C) (Lop_isNilpotent C)
    (g := LinearMap.mulLeft ℂ F) (LinearMap.ext fun G => by simp [h])
  simpa using LinearMap.congr_fun this G

open Classical in
/-- `C` restricted to `X × X`. -/
def restr (C : Matrix Λ Λ ℝ) (X : Set Λ) : Matrix Λ Λ ℝ :=
  fun x y => if x ∈ X ∧ y ∈ X then C x y else 0

theorem Lop_restr_mul_right (C : Matrix Λ Λ ℝ) {X Y : Set Λ} (hXY : Disjoint X Y) {G : N Λ}
    (hG : G ∈ NX Y) (H : N Λ) : Lop (restr C X) (H * G) = Lop (restr C X) H * G := by
  rw [Lop_apply, Lop_apply, sum_mul]
  refine sum_congr rfl fun x _ => ?_
  rw [sum_mul]
  refine sum_congr rfl fun y _ => ?_
  by_cases hxy : x ∈ X ∧ y ∈ X
  · have hx : x ∉ Y := Set.disjoint_left.1 hXY hxy.1
    have hy : y ∉ Y := Set.disjoint_left.1 hXY hxy.2
    rw [smul_mul_assoc, D_mul, D_eq_zero_of_mem_NX hG hx, mul_zero, add_zero, D_mul,
      D_eq_zero_of_mem_NX hG hy, mul_zero, add_zero]
  · simp [restr, hxy]

theorem Lop_restr_mul_left (C : Matrix Λ Λ ℝ) {X Y : Set Λ} (hXY : Disjoint X Y) {F : N Λ}
    (hF : F ∈ NX X) (G : N Λ) : Lop (restr C Y) (F * G) = F * Lop (restr C Y) G := by
  rw [Lop_apply, Lop_apply, mul_sum]
  refine sum_congr rfl fun x _ => ?_
  rw [mul_sum]
  refine sum_congr rfl fun y _ => ?_
  by_cases hxy : x ∈ Y ∧ y ∈ Y
  · have hx : x ∉ X := Set.disjoint_right.1 hXY hxy.1
    have hy : y ∉ X := Set.disjoint_right.1 hXY hxy.2
    rw [mul_smul_comm, D_mul, D_eq_zero_of_mem_NX hF hx, zero_mul, zero_add, D_mul,
      D_inv', D_eq_zero_of_mem_NX hF hy, map_zero, neg_zero, zero_mul, zero_add, inv'_inv']
  · simp [restr, hxy]

theorem Lop_restr_eq_zero (C : Matrix Λ Λ ℝ) {X Y : Set Λ} (hXY : Disjoint X Y) {F : N Λ}
    (hF : F ∈ NX X) : Lop (restr C Y) F = 0 := by
  have := Lop_restr_mul_left C hXY hF 1
  rw [mul_one] at this
  rw [this, Lop_apply]; simp

/-- On `𝒩(X_1 ∪ X_2)`, `ℒ_C = ℒ_{C_1} + ℒ_{C_2}` if `C` vanishes between `X_1` and `X_2`. -/
theorem Lop_eq_add_restr (C : Matrix Λ Λ ℝ) {X₁ X₂ : Set Λ} (hX : Disjoint X₁ X₂)
    (hC : ∀ x ∈ X₁, ∀ y ∈ X₂, C x y = 0 ∧ C y x = 0) {G : N Λ} (hG : G ∈ NX (X₁ ∪ X₂)) :
    Lop C G = Lop (restr C X₁ + restr C X₂) G := by
  rw [Lop_apply, Lop_apply]
  refine sum_congr rfl fun x _ => sum_congr rfl fun y _ => ?_
  by_cases hx : x ∈ X₁ ∪ X₂
  · by_cases hy : y ∈ X₁ ∪ X₂
    · congr 1
      simp only [Matrix.add_apply, restr]
      rcases hx with hx | hx <;> rcases hy with hy | hy
      · simp [hx, hy, Set.disjoint_left.1 hX hx]
      · simp [hx, hy, Set.disjoint_left.1 hX hx, Set.disjoint_right.1 hX hy, (hC x hx y hy).1]
      · simp [hx, hy, Set.disjoint_right.1 hX hx, Set.disjoint_left.1 hX hy, (hC y hy x hx).2]
      · simp [hx, hy, Set.disjoint_right.1 hX hx]
    · rw [D_eq_zero_of_mem_NX (D_mem_NX hG _) hy, smul_zero, smul_zero]
  · rw [D_eq_zero_of_mem_NX hG hx, map_zero, smul_zero, smul_zero]

/-- Factorisation of `𝔼_C θ` for `F_i ∈ 𝒩(X_i)` when `C` vanishes between the disjoint sets
`X_1` and `X_2`: `𝔼_C θ (F_1 F_2) = (𝔼_C θ F_1)(𝔼_C θ F_2)`. -/
theorem EC_theta_mul_of_disjoint (C : Matrix Λ Λ ℝ) {X₁ X₂ : Set Λ} (hX : Disjoint X₁ X₂)
    (hC : ∀ x ∈ X₁, ∀ y ∈ X₂, C x y = 0 ∧ C y x = 0) {F₁ F₂ : N Λ} (hF₁ : F₁ ∈ NX X₁)
    (hF₂ : F₂ ∈ NX X₂) :
    EC C (theta (F₁ * F₂)) = EC C (theta F₁) * EC C (theta F₂) := by
  rw [EC_theta, EC_theta, EC_theta]
  set C₁ := restr C X₁
  set C₂ := restr C X₂
  -- `e^{ℒ_C} = e^{ℒ_{C_1 + C_2}}` on `𝒩(X_1 ∪ X_2)`
  have hsub : ∀ G ∈ NX (X₁ ∪ X₂), expL C G = expL (C₁ + C₂) G := by
    intro G hG
    have hk : ∀ k, (Lop C ^ k) G = (Lop (C₁ + C₂) ^ k) G := by
      intro k
      induction k with
      | zero => rfl
      | succ k ih =>
        rw [pow_succ', Module.End.mul_apply, ih, pow_succ', Module.End.mul_apply]
        exact Lop_eq_add_restr C hX hC (Lop_pow_mem_NX _ hG k)
    rw [expL_apply_eq_sum, expL_apply_eq_sum]
    refine sum_congr rfl fun k _ => ?_
    simp only [LinearMap.smul_apply, hk]
  have hsplit : ∀ G, expL (C₁ + C₂) G = expL C₁ (expL C₂ G) := by
    intro G
    unfold expL
    rw [Lop_add, IsNilpotent.exp_add_of_commute (Lop_commute _ _) (Lop_isNilpotent _)
      (Lop_isNilpotent _)]
    rfl
  have hsplit' : ∀ G, expL (C₁ + C₂) G = expL C₂ (expL C₁ G) := by
    intro G
    unfold expL
    rw [Lop_add, add_comm, IsNilpotent.exp_add_of_commute (Lop_commute _ _) (Lop_isNilpotent _)
      (Lop_isNilpotent _)]
    rfl
  have h12 : F₁ * F₂ ∈ NX (X₁ ∪ X₂) :=
    mul_mem (NX_mono Set.subset_union_left hF₁) (NX_mono Set.subset_union_right hF₂)
  rw [hsub _ h12, hsub _ (NX_mono Set.subset_union_left hF₁),
    hsub _ (NX_mono Set.subset_union_right hF₂), hsplit, hsplit, hsplit',
    expL_mul_left C₂ F₁ (Lop_restr_mul_left C hX hF₁),
    expL_eq_self C₂ (Lop_restr_eq_zero C hX hF₁),
    expL_eq_self C₁ (Lop_restr_eq_zero C hX.symm hF₂),
    expL_mul_right C₁ _ (Lop_restr_mul_right C hX (expL_mem_NX C₂ hF₂))]

end

end Grassmann
