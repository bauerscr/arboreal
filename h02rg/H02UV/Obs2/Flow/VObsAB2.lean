import Obs2.Flow.VObsAB1
import Obs2.Flow.Tau2Bd

/-!
# Second-order gradient and determinant defects of a Gram covariance

`norm_m2Def_le`, `norm_detDef_le` (`Obs2/Pair/PairRed.lean`) bound the defects
`C(a,a) + C(b,b) − C(a,b) − C(b,a)` and `C(a,a)C(b,b) − C(a,b)C(b,a)` to **first** order in
`|b − a|/L^{k+1}`. With a Gram representation `C(x,y) = ⟨F_x, G_y⟩` both are exactly of
**second** order:

* `C(a,a) + C(b,b) − C(a,b) − C(b,a) = ⟨F_a − F_b, G_a − G_b⟩`;
* `C(a,a)C(b,b) − C(a,b)C(b,a) = ⟨F_a,G_a⟩⟨f,g⟩ − ⟨F_a,g⟩⟨f,G_a⟩`, `f = F_b − F_a`, `g = G_b − G_a`.

With the gradient bounds of `GoodCov2 k ℓ` (`‖F_{x+e} − F_x‖ ≤ ℓ/L^{k+1}`, `‖F_x‖ ≤ ℓ`):

* **`norm_m2Def_le2`**: `|m2Def| ≤ (nℓ/L^{k+1})²`;
* **`norm_detDef_le2`**: `|detDef| ≤ 2ℓ²(nℓ/L^{k+1})²`,

for `b = a + w`, `|w| = n`. Along the reduced history (`n ≍ L^{j_x}`) this is the decay
`L^{-2(k-j_x)}`, which matches the growth `(L^k/|x|)²` of the quartic coefficient `M₄` generated by
the barycentric localisation (`norm_Mw_le`): `|M₄|·|defect|` is then of the size of the norm of the
quartic part, `‖M₄ψ̄_aψ_aψ̄_bψ_b‖_{T_k} ≍ |M₄|ℓ⁴(|x|/L^k)²` (`tNorm_m4_le`).
-/

set_option linter.unusedSectionVars false

namespace Obs2

noncomputable section

open Finset Grassmann Loc Step Step2 FRD

variable {L N : ℕ} [NeZero L]

/-- **Path Lipschitz bound** for vector-valued functions. -/
theorem norm_sub_path_le' {E : Type*} [SeminormedAddCommGroup E] {f : Lam 2 L N → E} {δ : ℝ}
    (hf : ∀ x e, ‖f (x + dirVec e) - f x‖ ≤ δ) :
    ∀ (w : List (Dir 2)) (a : Lam 2 L N), ‖f (pathEnd a w) - f a‖ ≤ w.length * δ
  | [], a => by simp [pathEnd]
  | e :: w, a => by
    have h1 := norm_sub_path_le' hf w (a + dirVec e)
    have h2 := hf a e
    have e1 : pathEnd a (e :: w) = pathEnd (a + dirVec e) w := by
      simp [pathEnd, add_assoc]
    rw [e1]
    calc ‖f (pathEnd (a + dirVec e) w) - f a‖
        ≤ ‖f (pathEnd (a + dirVec e) w) - f (a + dirVec e)‖ + ‖f (a + dirVec e) - f a‖ := by
          have := norm_add_le (f (pathEnd (a + dirVec e) w) - f (a + dirVec e))
            (f (a + dirVec e) - f a)
          rwa [sub_add_sub_cancel] at this
      _ ≤ w.length * δ + δ := add_le_add h1 h2
      _ = (e :: w).length * δ := by simp; ring

variable {k : ℕ} {ℓC : ℝ} {C : Matrix (Lam 2 L N) (Lam 2 L N) ℂ}

/-- The Gram vectors of a `GoodCov2` covariance: sizes and path increments. -/
theorem good_gram_path (hC : GoodCov2 k ℓC C) :
    ∃ (H : Type) (_ : NormedAddCommGroup H) (_ : InnerProductSpace ℂ H) (Fv Gv : Lam 2 L N → H),
      IsGram C Fv Gv ∧ (∀ x, ‖Fv x‖ ≤ ℓC ∧ ‖Gv x‖ ≤ ℓC) ∧
      ∀ (a : Lam 2 L N) (w : List (Dir 2)),
        ‖Fv (pathEnd a w) - Fv a‖ ≤ w.length * (ℓC / (L : ℝ) ^ (k + 1)) ∧
        ‖Gv (pathEnd a w) - Gv a‖ ≤ w.length * (ℓC / (L : ℝ) ^ (k + 1)) := by
  obtain ⟨H, i1, i2, Fv, Gv, hG, hB⟩ := hC.gram
  refine ⟨H, i1, i2, Fv, Gv, hG, fun x => ?_, fun a w => ⟨?_, ?_⟩⟩
  · obtain ⟨h1, h2⟩ := hB 0 (by simp [Grassmann.mabs]) x
    simp only [Grassmann.mabs, Pi.zero_apply, sum_const_zero, pow_zero, inv_one, mul_one] at h1 h2
    rw [dprof_zero, gvec_single] at h1 h2
    exact ⟨h1, h2⟩
  · refine norm_sub_path_le' (f := Fv) (fun x e => ?_) w a
    obtain ⟨h1, -⟩ := hB (Pi.single e 1) (by rw [mabs_single_tau]; simp [pPhi]) x
    rw [mabs_single_tau, pow_one, gvec_dprof_single, add_comm] at h1
    rwa [div_eq_mul_inv]
  · refine norm_sub_path_le' (f := Gv) (fun x e => ?_) w a
    obtain ⟨-, h1⟩ := hB (Pi.single e 1) (by rw [mabs_single_tau]; simp [pPhi]) x
    rw [mabs_single_tau, pow_one, gvec_dprof_single, add_comm] at h1
    rwa [div_eq_mul_inv]

/-- **The `m₂` (gradient) defect is of second order**:
`|C(a,a) + C(b,b) − C(a,b) − C(b,a)| ≤ (nℓ/L^{k+1})²` for `b = a + w`, `|w| = n`. -/
theorem norm_m2Def_le2 (hC : GoodCov2 k ℓC C) (a : Lam 2 L N) (w : List (Dir 2)) :
    ‖C a a + C (pathEnd a w) (pathEnd a w) - C a (pathEnd a w) - C (pathEnd a w) a‖ ≤
      (w.length * (ℓC / (L : ℝ) ^ (k + 1))) ^ 2 := by
  obtain ⟨H, _, _, Fv, Gv, hG, -, hP⟩ := good_gram_path hC
  set b := pathEnd a w
  obtain ⟨hF, hGv⟩ := hP a w
  have e : C a a + C b b - C a b - C b a = inner ℂ (Fv b - Fv a) (Gv b - Gv a) := by
    rw [hG, hG, hG, hG, inner_sub_left, inner_sub_right, inner_sub_right]; ring
  rw [e, sq]
  exact (norm_inner_le_norm _ _).trans
    (mul_le_mul hF hGv (norm_nonneg _) ((norm_nonneg _).trans hF))

/-- **The determinant defect is of second order**:
`|C(a,a)C(b,b) − C(a,b)C(b,a)| ≤ 2ℓ²(nℓ/L^{k+1})²` for `b = a + w`, `|w| = n`. -/
theorem norm_detDef_le2 (hC : GoodCov2 k ℓC C) (a : Lam 2 L N) (w : List (Dir 2)) :
    ‖C a a * C (pathEnd a w) (pathEnd a w) - C a (pathEnd a w) * C (pathEnd a w) a‖ ≤
      2 * ℓC ^ 2 * (w.length * (ℓC / (L : ℝ) ^ (k + 1))) ^ 2 := by
  obtain ⟨H, _, _, Fv, Gv, hG, hS, hP⟩ := good_gram_path hC
  set b := pathEnd a w
  obtain ⟨hF, hGv⟩ := hP a w
  set δ := w.length * (ℓC / (L : ℝ) ^ (k + 1))
  set f := Fv b - Fv a
  set g := Gv b - Gv a
  have hFb : Fv b = Fv a + f := by rw [add_sub_cancel]
  have hGb : Gv b = Gv a + g := by rw [add_sub_cancel]
  have e : C a a * C b b - C a b * C b a =
      inner ℂ (Fv a) (Gv a) * inner ℂ f g - inner ℂ (Fv a) g * inner ℂ f (Gv a) := by
    rw [hG, hG, hG, hG, hFb, hGb]
    simp only [inner_add_left, inner_add_right]
    ring
  rw [e]
  have hFa := (hS a).1
  have hGa := (hS a).2
  have hℓ : 0 ≤ ℓC := (norm_nonneg _).trans hFa
  have hδ : 0 ≤ δ := (norm_nonneg _).trans hF
  have n1 : ‖inner ℂ (Fv a) (Gv a) * inner ℂ f g‖ ≤ ℓC ^ 2 * δ ^ 2 := by
    rw [norm_mul]
    have a1 : ‖inner ℂ (Fv a) (Gv a)‖ ≤ ℓC ^ 2 := (norm_inner_le_norm _ _).trans (by
      rw [sq]; exact mul_le_mul hFa hGa (norm_nonneg _) hℓ)
    have a2 : ‖inner ℂ f g‖ ≤ δ ^ 2 := (norm_inner_le_norm _ _).trans (by
      rw [sq]; exact mul_le_mul hF hGv (norm_nonneg _) hδ)
    exact mul_le_mul a1 a2 (norm_nonneg _) (sq_nonneg _)
  have n2 : ‖inner ℂ (Fv a) g * inner ℂ f (Gv a)‖ ≤ ℓC ^ 2 * δ ^ 2 := by
    rw [norm_mul]
    have a1 : ‖inner ℂ (Fv a) g‖ ≤ ℓC * δ := (norm_inner_le_norm _ _).trans
      (mul_le_mul hFa hGv (norm_nonneg _) hℓ)
    have a2 : ‖inner ℂ f (Gv a)‖ ≤ δ * ℓC := (norm_inner_le_norm _ _).trans
      (mul_le_mul hF hGa (norm_nonneg _) hδ)
    calc _ ≤ (ℓC * δ) * (δ * ℓC) := mul_le_mul a1 a2 (norm_nonneg _) (by positivity)
      _ = ℓC ^ 2 * δ ^ 2 := by ring
  refine (norm_sub_le _ _).trans ?_
  linarith

end

end Obs2
