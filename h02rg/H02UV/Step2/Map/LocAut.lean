import Step2.Map.LocTr

/-!
# Lattice symmetries of the symmetric localisation (`h02uv-outline.tex`, Lemma `lem:C0`(iii))

Every lattice automorphism generated by translations, reflections and permutations (`IsGen`)
acts on the unit directions as a signed permutation `(π, s)` (`SPerm`, `isGen_sperm`):
`T e_i = s_i e_{π i}` on `ℤ^d`, and `(T.A v)_{π i} = s_i v_i` on `ℝ^d`. Hence

* `autAlg_mono4s`: `τ M̂^{ik}_x = s_i s_k M̂^{π i, π k}_{T x}`;
* `mu4_aut`: `μ⁽⁴⁾_{π κ, π κ'}(τ F) = s_κ s_κ' μ⁽⁴⁾_{κ κ'}(F)` (base points `b_{TX}` and `b_X`);
* `Loc4sXY_aut`, `Loc2sXY_aut`: `τ Loĉ_{X,Y} F = Loĉ_{TX,TY} τ F` for `F` supported in a region of
  `X`.
-/

namespace Step2

open Step

noncomputable section

open Finset Grassmann Loc FRD Matrix

variable {d L N : ℕ} [NeZero L]

/-! ### Signed permutations -/

/-- `T` acts on the unit directions as the signed permutation `(π, s)`. -/
structure SPerm (T : AffAut d L N) (π : Equiv.Perm (Fin d)) (s : Fin d → ℤ) : Prop where
  hs : ∀ i, s i = 1 ∨ s i = -1
  hRz : ∀ i, T.Rz (Pi.single i 1) = s i • (Pi.single (π i) 1 : Zd d)
  hA : ∀ (v : Fin d → ℝ) i, T.A v (π i) = (s i : ℝ) * v i

theorem sperm_transl (t : Lam d L N) : SPerm (AffAut.transl t) (Equiv.refl _) (fun _ => 1) where
  hs _ := Or.inl rfl
  hRz _ := by simp [AffAut.transl]
  hA _ _ := by simp [AffAut.transl]

theorem sperm_refl (m : Fin d) :
    SPerm (AffAut.refl (L := L) (N := N) m) (Equiv.refl _) (fun i => if i = m then -1 else 1) where
  hs i := by by_cases h : i = m <;> simp [h]
  hRz i := by
    show reflZ m (ez i) = _
    rw [reflZ_ez]
    by_cases h : i = m <;> simp [h, ez]
  hA v i := by
    show reflA m v i = _
    by_cases h : i = m <;> simp [reflA, h]

theorem sperm_perm (σ : Equiv.Perm (Fin d)) :
    SPerm (AffAut.perm (L := L) (N := N) σ) σ (fun _ => 1) where
  hs _ := Or.inl rfl
  hRz i := by
    show permZ σ (ez i) = _
    rw [permZ_ez]; simp [ez]
  hA v i := by
    show permA σ v (σ i) = _
    simp [permA]

theorem sperm_comp {T₁ T₂ : AffAut d L N} {π₁ π₂ : Equiv.Perm (Fin d)} {s₁ s₂ : Fin d → ℤ}
    (h₁ : SPerm T₁ π₁ s₁) (h₂ : SPerm T₂ π₂ s₂) :
    SPerm (T₁.comp T₂) (π₁.trans π₂) (fun i => s₁ i * s₂ (π₁ i)) where
  hs i := by
    rcases h₁.hs i with h | h <;> rcases h₂.hs (π₁ i) with h' | h' <;> simp [h, h']
  hRz i := by
    show T₂.Rz (T₁.Rz (Pi.single i 1)) = _
    rw [h₁.hRz, map_zsmul, h₂.hRz, smul_smul]
    simp [mul_comm]
  hA v i := by
    show T₂.A (T₁.A v) (π₂ (π₁ i)) = _
    rw [h₂.hA, h₁.hA]; push_cast; ring

theorem isGen_sperm {T : AffAut d L N} (hT : IsGen T) : ∃ π s, SPerm T π s := by
  induction hT with
  | transl t => exact ⟨_, _, sperm_transl t⟩
  | refl m => exact ⟨_, _, sperm_refl m⟩
  | perm σ => exact ⟨_, _, sperm_perm σ⟩
  | comp _ _ ih₁ ih₂ =>
    obtain ⟨π₁, s₁, h₁⟩ := ih₁
    obtain ⟨π₂, s₂, h₂⟩ := ih₂
    exact ⟨_, _, sperm_comp h₁ h₂⟩

/-! ### The action on the quartic monomials -/

/-- The induced map on the unit directions. -/
def sdir (π : Equiv.Perm (Fin d)) (s : Fin d → ℤ) : Dir d → Dir d
  | Sum.inl i => if s i = 1 then Sum.inl (π i) else Sum.inr (π i)
  | Sum.inr i => if s i = 1 then Sum.inr (π i) else Sum.inl (π i)

namespace SPerm

variable {T : AffAut d L N} {π : Equiv.Perm (Fin d)} {s : Fin d → ℤ} (h : SPerm T π s)
include h

theorem Rz_dirZ (e : Dir d) : T.Rz (dirZ e) = dirZ (sdir π s e) := by
  rcases e with i | i
  · rw [dirZ, h.hRz]
    rcases h.hs i with hi | hi <;> simp [sdir, hi, dirZ]
  · rw [dirZ, map_neg, h.hRz]
    rcases h.hs i with hi | hi <;> simp [sdir, hi, dirZ]

theorem E_add_dirVec (x : Lam d L N) (e : Dir d) :
    T.E (x + dirVec e) = T.E x + dirVec (sdir π s e) := by
  rw [T.hE, map_add, ← prj_dirZ e, T.hRz, h.Rz_dirZ, prj_dirZ, T.hE x]
  abel

theorem autAlg_gmono4 (e e' : Dir d) (x : Lam d L N) :
    autAlg T.E (gmono4 e e' x) = gmono4 (sdir π s e) (sdir π s e') (T.E x) := by
  rw [gmono4_eq, gmono4_eq]
  simp only [map_mul, map_sub, autAlg_ψ, h.E_add_dirVec]

theorem autAlg_mono4s (i k : Fin d) (x : Lam d L N) :
    autAlg T.E (mono4s i k x) = ((s i * s k : ℤ) : ℂ) • mono4s (π i) (π k) (T.E x) := by
  unfold mono4s
  by_cases hik : i = k
  · subst hik
    rw [if_pos rfl, if_pos rfl, map_smul, map_add, h.autAlg_gmono4, h.autAlg_gmono4]
    rcases h.hs i with hi | hi
    · simp [sdir, hi]
    · simp only [sdir, hi, if_neg (show (-1 : ℤ) ≠ 1 by decide)]
      push_cast; rw [smul_smul]; norm_num; abel
  · have hπ : π i ≠ π k := π.injective.ne hik
    rw [if_neg hik, if_neg hπ, map_smul, map_add, map_sub, map_sub, h.autAlg_gmono4,
      h.autAlg_gmono4, h.autAlg_gmono4, h.autAlg_gmono4]
    rcases h.hs i with hi | hi <;> rcases h.hs k with hk | hk <;>
      simp only [sdir, hi, hk, if_pos, if_neg (show (-1 : ℤ) ≠ 1 by decide)] <;>
      push_cast <;> module

theorem autAlg_mono4sSet (i k : Fin d) (Y : Finset (Lam d L N)) :
    autAlg T.E (mono4sSet i k Y) = ((s i * s k : ℤ) : ℂ) • mono4sSet (π i) (π k) (T.img Y) := by
  rw [mono4sSet, map_sum, mono4sSet, AffAut.img, sum_map, smul_sum]
  exact sum_congr rfl fun x _ => h.autAlg_mono4s i k x

/-! ### The action on the quartic pairings -/

/-- **The quartic pairings under `T`.** -/
theorem mu4_aut {X : Finset (Lam d L N)} {R : Set (Lam d L N)} (hR : Region X R)
    (hne : X.Nonempty) {F : Alg d L N} (hF : F ∈ NX R) (κ κ' : Fin d) :
    mu4 (base (T.img X)) (π κ) (π κ') (autAlg T.E F) =
      ((s κ * s κ' : ℤ) : ℂ) * mu4 (base X) κ κ' F := by
  set b := base X
  set b' := base (T.img X)
  obtain ⟨z, hz, hz'⟩ := Finset.mem_map.1 (base_mem (T.img_nonempty hne))
  have hz'' : T.E z = b' := hz'
  have hbR := hR.mem (base_mem hne)
  have hlift : ∀ y ∈ R, lift b' (T.E y) = T.A (lift b y) + lift b' (T.E b) := by
    intro y hy
    refine T.lift_E ?_
    have h1 : 4 * (supNorm (y - b) + 1) < L ^ N := hR.diam y hy _ hbR
    have h2 : 4 * (supNorm (b - z) + 1) < L ^ N := hR.diam _ hbR z (hR.mem hz)
    have h3 : supNorm (T.E b - T.E z) ≤ supNorm (b - z) := T.supNorm_E_sub b z
    rw [← hz'']
    omega
  set c := lift b' (T.E b)
  have hcf : ∀ y : Fin 4 → Lam d L N,
      cf4 (autAlg T.E F) (fun r => T.E (y r)) = cf4 F y := by
    intro y
    simp only [cf4, coeff_autAlg, Equiv.symm_apply_apply]
  have hterm : ∀ y : Fin 4 → Lam d L N,
      cf4 F y * ((lift b' (T.E (y 0)) (π κ) * lift b' (T.E (y 1)) (π κ') : ℝ) : ℂ) =
        ((s κ * s κ' : ℤ) : ℂ) * (cf4 F y * ((lift b (y 0) κ * lift b (y 1) κ' : ℝ) : ℂ)) +
        cf4 F y * (((s κ : ℝ) * lift b (y 0) κ * c (π κ') : ℝ) : ℂ) +
        cf4 F y * ((c (π κ) * ((s κ' : ℝ) * lift b (y 1) κ') : ℝ) : ℂ) +
        cf4 F y * ((c (π κ) * c (π κ') : ℝ) : ℂ) := by
    intro y
    by_cases hy : ∀ r, y r ∈ R
    · rw [hlift _ (hy 0), hlift _ (hy 1)]
      simp only [Pi.add_apply, h.hA]
      push_cast; ring
    · push_neg at hy
      obtain ⟨r, hr⟩ := hy
      simp [cf4_eq_zero_of_mem_NX hF y r hr]
  have h02 : (0 : Fin 4) ≠ 2 := by decide
  have h13 : (1 : Fin 4) ≠ 3 := by decide
  have p02 : pat4 0 = pat4 2 := by decide
  have p13 : pat4 1 = pat4 3 := by decide
  have s1 := sum_cf4_eq_zero F 1 3 h13 p13
    (fun y => (((s κ : ℝ) * lift b (y 0) κ * c (π κ') : ℝ) : ℂ))
    fun y => by simp [Equiv.swap_apply_of_ne_of_ne (show (0 : Fin 4) ≠ 1 by decide)
      (show (0 : Fin 4) ≠ 3 by decide)]
  have s2 := sum_cf4_eq_zero F 0 2 h02 p02
    (fun y => ((c (π κ) * ((s κ' : ℝ) * lift b (y 1) κ') : ℝ) : ℂ))
    fun y => by simp [Equiv.swap_apply_of_ne_of_ne (show (1 : Fin 4) ≠ 0 by decide)
      (show (1 : Fin 4) ≠ 2 by decide)]
  have s3 := sum_cf4_eq_zero F 0 2 h02 p02 (fun _ => ((c (π κ) * c (π κ') : ℝ) : ℂ))
    fun _ => rfl
  have e1 : mu4 b' (π κ) (π κ') (autAlg T.E F) =
      ∑ y : Fin 4 → Lam d L N,
        cf4 F y * ((lift b' (T.E (y 0)) (π κ) * lift b' (T.E (y 1)) (π κ') : ℝ) : ℂ) := by
    rw [mu4]
    refine (Fintype.sum_equiv (Equiv.arrowCongr (Equiv.refl _) T.E) _ _ fun y => ?_).symm
    rw [show (Equiv.arrowCongr (Equiv.refl _) T.E) y = fun r => T.E (y r) from rfl, hcf]
  rw [e1]
  simp only [hterm, sum_add_distrib, s1, s2, s3, add_zero, ← mul_sum]
  rfl

end SPerm

/-! ### Covariance of the symmetric localisation -/

theorem SPerm.Loc4sXY_aut {T : AffAut d L N} {π : Equiv.Perm (Fin d)} {s : Fin d → ℤ}
    (h : SPerm T π s) {X : Finset (Lam d L N)} {R : Set (Lam d L N)} (hR : Region X R)
    (hne : X.Nonempty) (Y : Finset (Lam d L N)) {F : Alg d L N} (hF : F ∈ NX R) :
    autAlg T.E (Loc4sXY X Y F) = Loc4sXY (T.img X) (T.img Y) (autAlg T.E F) := by
  have e : ∀ G : Fin d → Fin d → Alg d L N, ∑ a, ∑ b, G a b = ∑ i, ∑ k, G (π i) (π k) := by
    intro G
    rw [← Equiv.sum_comp π]
    exact sum_congr rfl fun i _ => (Equiv.sum_comp π _).symm
  rw [Loc4sXY, Loc4sXY, map_sum]
  simp only [map_sum, map_smul, h.autAlg_mono4sSet, smul_smul, T.card_img]
  conv_rhs => rw [e]
  refine sum_congr rfl fun i _ => sum_congr rfl fun k _ => ?_
  rw [h.mu4_aut hR hne hF]
  congr 1
  rcases h.hs i with hi | hi <;> rcases h.hs k with hk | hk <;> simp [hi, hk] <;> ring

/-- **Lemma `lem:C0`(iii)**: `τ Loĉ_{X,Y} F = Loĉ_{TX,TY} τF` for every lattice symmetry. -/
theorem Loc2sXY_aut {T : AffAut d L N} (hT : IsGen T) {X : Finset (Lam d L N)}
    {R : Set (Lam d L N)} (hR : Region X R) (hne : X.Nonempty) (Y : Finset (Lam d L N))
    {F : Alg d L N} (hF : F ∈ NX R) :
    autAlg T.E (Loc2sXY X Y F) = Loc2sXY (T.img X) (T.img Y) (autAlg T.E F) := by
  obtain ⟨π, s, h⟩ := isGen_sperm hT
  rw [Loc2sXY, map_add, h.Loc4sXY_aut hR hne Y hF, Loc2sXY, T.LocXY_aut hR hne F hF]

end

end Step2
