import Step2.Map.Coord

/-!
# Factorisation of the complex Gaussian expectation over separated `ζ`-supports

The integrated fields `ζ` are the second copy in `Λ ⊔ Λ`. For `X ⊆ Λ` let
`𝒩_ζ(X) = 𝒩(Λ ⊔ X)` be generated by all `ψ` and by `ζ_x`, `x ∈ X` (`NZ`). If `C` vanishes
between the disjoint sets `X₁`, `X₂`, then (`ECC_mul_of_sepZ`)

  `𝔼_C (F₁ F₂) = (𝔼_C F₁)(𝔼_C F₂)`   for `F_i ∈ 𝒩_ζ(X_i)`.

Proof: by supercommutativity (`mul_eq_supercomm`), `𝒩_ζ(X)` is spanned by `incl A · inclζ B` with
`B ∈ 𝒩(X)` (`NZ_le_span`); `𝔼_C(incl A · inclζ B) = ⟨B⟩_C A`; and `⟨·⟩_C` is multiplicative on
`𝒩(X₁) × 𝒩(X₂)` and vanishes on odd elements.
-/

namespace Step2

noncomputable section

open Finset Grassmann

section Super

variable {Λ : Type*} [DecidableEq Λ]

/-- The even part. -/
def evP (x : Grassmann.N Λ) : Grassmann.N Λ := (1 / 2 : ℂ) • (x + inv' x)

/-- The odd part. -/
def odP (x : Grassmann.N Λ) : Grassmann.N Λ := (1 / 2 : ℂ) • (x - inv' x)

theorem evP_add (a b : Grassmann.N Λ) : evP (a + b) = evP a + evP b := by
  simp only [evP, map_add]; module

theorem odP_add (a b : Grassmann.N Λ) : odP (a + b) = odP a + odP b := by
  simp only [odP, map_add]; module

theorem evP_mul (a b : Grassmann.N Λ) :
    evP (a * b) = evP a * evP b + odP a * odP b := by
  simp only [evP, odP, map_mul, smul_mul_smul_comm, mul_add, add_mul, mul_sub, sub_mul]
  module

theorem odP_mul (a b : Grassmann.N Λ) :
    odP (a * b) = odP a * evP b + evP a * odP b := by
  simp only [evP, odP, map_mul, smul_mul_smul_comm, mul_add, add_mul, mul_sub, sub_mul]
  module

/-- **Supercommutativity**: `x y = y x_ev + (inv' y) x_odd`. -/
theorem mul_eq_supercomm (x y : Grassmann.N Λ) : x * y = y * evP x + inv' y * odP x := by
  induction x using CliffordAlgebra.induction generalizing y with
  | algebraMap r =>
    have h1 : evP (algebraMap ℂ (Grassmann.N Λ) r) = algebraMap ℂ _ r := by
      simp only [evP, AlgHom.commutes]; module
    have h2 : odP (algebraMap ℂ (Grassmann.N Λ) r) = 0 := by simp [odP]
    rw [h1, h2, mul_zero, add_zero, Algebra.commutes]
  | ι m =>
    have h1 : evP (ExteriorAlgebra.ι ℂ m) = 0 := by simp [evP, inv'_ι]
    have h2 : odP (ExteriorAlgebra.ι ℂ m) = ExteriorAlgebra.ι ℂ m := by
      simp only [odP, inv'_ι, sub_neg_eq_add]; module
    rw [h1, h2, mul_zero, zero_add, ι_mul_eq]
  | mul a b ha hb =>
    rw [mul_assoc, hb, mul_add, ← mul_assoc, ← mul_assoc, ha, ha (inv' y), inv'_inv', evP_mul,
      odP_mul]
    noncomm_ring
  | add a b ha hb =>
    rw [add_mul, ha, hb, evP_add, odP_add]
    noncomm_ring

end Super

section Doubled

variable {Λ : Type*} [DecidableEq Λ] [Fintype Λ]

theorem inclζ_inv' (B : Grassmann.N Λ) : inclζ (inv' B) = inv' (inclζ B) := by
  rw [inclζ, inv'_map]

theorem incl_inv' (A : Grassmann.N Λ) : incl (inv' A) = inv' (incl A) := by
  rw [incl, inv'_map]

theorem inclζ_evP (B : Grassmann.N Λ) : inclζ (evP B) = evP (inclζ B) := by
  simp [evP, inclζ_inv']

theorem inclζ_odP (B : Grassmann.N Λ) : inclζ (odP B) = odP (inclζ B) := by
  simp [odP, inclζ_inv']

theorem inclζ_mul_incl (A B : Grassmann.N Λ) :
    inclζ B * incl A = incl A * inclζ (evP B) + incl (inv' A) * inclζ (odP B) := by
  rw [mul_eq_supercomm, inclζ_evP, inclζ_odP, incl_inv']

theorem evP_mem_NX {X : Set Λ} {B : Grassmann.N Λ} (hB : B ∈ NX X) : evP B ∈ NX X :=
  Subalgebra.smul_mem _ (add_mem hB (inv'_mem_NX hB)) _

theorem odP_mem_NX {X : Set Λ} {B : Grassmann.N Λ} (hB : B ∈ NX X) : odP B ∈ NX X :=
  Subalgebra.smul_mem _ (sub_mem hB (inv'_mem_NX hB)) _

/-- `𝒩_ζ(X)`: all `ψ`, and `ζ_x` for `x ∈ X`. -/
def NZ (X : Set Λ) : Subalgebra ℂ (Grassmann.N (Λ ⊕ Λ)) := NX (Set.range Sum.inl ∪ Sum.inr '' X)

/-- The span of `incl A · inclζ B`, `B ∈ 𝒩(X)`. -/
def PZ (X : Set Λ) : Submodule ℂ (Grassmann.N (Λ ⊕ Λ)) :=
  Submodule.span ℂ {F | ∃ A B, B ∈ NX X ∧ F = incl A * inclζ B}

theorem PZ_mul {X : Set Λ} {F G : Grassmann.N (Λ ⊕ Λ)} (hF : F ∈ PZ X) (hG : G ∈ PZ X) :
    F * G ∈ PZ X := by
  induction hF using Submodule.span_induction with
  | mem F hF =>
    obtain ⟨A, B, hB, rfl⟩ := hF
    induction hG using Submodule.span_induction with
    | mem G hG =>
      obtain ⟨A', B', hB', rfl⟩ := hG
      have e : incl A * inclζ B * (incl A' * inclζ B') =
          incl (A * A') * inclζ (evP B * B') + incl (A * inv' A') * inclζ (odP B * B') := by
        rw [mul_assoc, ← mul_assoc (inclζ B), inclζ_mul_incl, map_mul, map_mul, map_mul, map_mul]
        noncomm_ring
      rw [e]
      exact add_mem (Submodule.subset_span ⟨_, _, mul_mem (evP_mem_NX hB) hB', rfl⟩)
        (Submodule.subset_span ⟨_, _, mul_mem (odP_mem_NX hB) hB', rfl⟩)
    | zero => rw [mul_zero]; exact zero_mem _
    | add x y _ _ hx hy => rw [mul_add]; exact add_mem hx hy
    | smul c x _ hx => rw [mul_smul_comm]; exact Submodule.smul_mem _ _ hx
  | zero => rw [zero_mul]; exact zero_mem _
  | add x y _ _ hx hy => rw [add_mul]; exact add_mem hx hy
  | smul c x _ hx => rw [smul_mul_assoc]; exact Submodule.smul_mem _ _ hx

theorem NZ_le_span {X : Set Λ} {F : Grassmann.N (Λ ⊕ Λ)} (hF : F ∈ NZ X) : F ∈ PZ X := by
  induction hF using Algebra.adjoin_induction with
  | mem x hx =>
    obtain ⟨⟨a, ha⟩, rfl⟩ := hx
    rcases a with ⟨b | b, σ⟩
    · refine Submodule.subset_span ⟨ψ (b, σ), 1, one_mem _, ?_⟩
      rw [map_one, mul_one, incl_psi]
    · have hb : b ∈ X := by simpa using ha
      refine Submodule.subset_span ⟨1, ψ (b, σ), ψ_mem_NX hb, ?_⟩
      rw [map_one, one_mul, inclζ, ψ, ExteriorAlgebra.map_apply_ι]
      show ExteriorAlgebra.ι ℂ (ev (Sum.inr b, σ)) = _
      congr 1
      ext ⟨c, τ⟩; cases c <;> simp [inrV, ev, Pi.single_apply, Prod.ext_iff]
  | algebraMap r =>
    refine Submodule.subset_span ⟨algebraMap ℂ _ r, 1, one_mem _, ?_⟩
    simp
  | add x y _ _ hx hy => exact add_mem hx hy
  | mul x y _ _ hx hy => exact PZ_mul hx hy

theorem omegaC_inv' (C : Matrix Λ Λ ℂ) (B : Grassmann.N Λ) :
    omegaC C (inv' B) = omegaC C B := by
  rw [omegaC, omegaC, expLC_inv']
  exact algebraMapInv_inv' _

theorem omegaC_odP (C : Matrix Λ Λ ℂ) (B : Grassmann.N Λ) : omegaC C (odP B) = 0 := by
  have : omegaC C (odP B) = (1 / 2 : ℂ) * (omegaC C B - omegaC C (inv' B)) := by
    simp [odP, omegaC, map_sub, smul_eq_mul]
  rw [this, omegaC_inv', sub_self, mul_zero]

theorem omegaC_evP (C : Matrix Λ Λ ℂ) (B : Grassmann.N Λ) : omegaC C (evP B) = omegaC C B := by
  have : omegaC C (evP B) = (1 / 2 : ℂ) * (omegaC C B + omegaC C (inv' B)) := by
    simp [evP, omegaC, map_add, smul_eq_mul]; ring
  rw [this, omegaC_inv']; ring

theorem omegaC_mul_of_disjoint (C : Matrix Λ Λ ℂ) {X₁ X₂ : Set Λ} (hX : Disjoint X₁ X₂)
    (hC : ∀ x ∈ X₁, ∀ y ∈ X₂, C x y = 0 ∧ C y x = 0) {B₁ B₂ : Grassmann.N Λ} (h₁ : B₁ ∈ NX X₁)
    (h₂ : B₂ ∈ NX X₂) : omegaC C (B₁ * B₂) = omegaC C B₁ * omegaC C B₂ := by
  rw [omegaC, omegaC, omegaC, expLC_mul_of_disjoint C hX hC h₁ h₂, map_mul]

/-- **Factorisation over separated `ζ`-supports.** -/
theorem ECC_mul_of_sepZ (C : Matrix Λ Λ ℂ) {X₁ X₂ : Set Λ} (hX : Disjoint X₁ X₂)
    (hC : ∀ x ∈ X₁, ∀ y ∈ X₂, C x y = 0 ∧ C y x = 0) {F₁ F₂ : Grassmann.N (Λ ⊕ Λ)}
    (h₁ : F₁ ∈ NZ X₁) (h₂ : F₂ ∈ NZ X₂) : ECC C (F₁ * F₂) = ECC C F₁ * ECC C F₂ := by
  have h₁' := NZ_le_span h₁
  have h₂' := NZ_le_span h₂
  clear h₁ h₂
  induction h₁' using Submodule.span_induction with
  | mem F hF =>
    obtain ⟨A, B, hB, rfl⟩ := hF
    induction h₂' using Submodule.span_induction with
    | mem G hG =>
      obtain ⟨A', B', hB', rfl⟩ := hG
      have e : incl A * inclζ B * (incl A' * inclζ B') =
          incl (A * A') * inclζ (evP B * B') + incl (A * inv' A') * inclζ (odP B * B') := by
        rw [mul_assoc, ← mul_assoc (inclζ B), inclζ_mul_incl, map_mul, map_mul, map_mul, map_mul]
        noncomm_ring
      rw [e, map_add, ECC_incl_mul_inclζ, ECC_incl_mul_inclζ, ECC_incl_mul_inclζ,
        ECC_incl_mul_inclζ, omegaC_mul_of_disjoint C hX hC (evP_mem_NX hB) hB',
        omegaC_mul_of_disjoint C hX hC (odP_mem_NX hB) hB', omegaC_evP, omegaC_odP, zero_mul,
        zero_smul, add_zero, smul_mul_smul_comm]
    | zero => rw [mul_zero, map_zero, mul_zero]
    | add x y _ _ hx hy => rw [mul_add, map_add, hx, hy, map_add, mul_add]
    | smul c x _ hx => rw [mul_smul_comm, map_smul, hx, map_smul, mul_smul_comm]
  | zero => rw [zero_mul, map_zero, zero_mul]
  | add x y _ _ hx hy => rw [add_mul, map_add, hx, hy, map_add, add_mul]
  | smul c x _ hx => rw [smul_mul_assoc, map_smul, hx, map_smul, smul_mul_assoc]

theorem theta_mem_NZ {X : Set Λ} {F : Grassmann.N Λ} (hF : F ∈ NX X) : theta F ∈ NZ X := by
  refine Step.algHom_mem_of_mem_NX _ (fun a ha => ?_) hF
  rw [theta_psi]
  exact add_mem (ψ_mem_NX (Or.inl ⟨a.1, rfl⟩)) (ψ_mem_NX (Or.inr ⟨_, ha, rfl⟩))

theorem mem_NX_univ (F : Grassmann.N Λ) : F ∈ NX (Set.univ : Set Λ) := by
  induction F using CliffordAlgebra.induction with
  | algebraMap r => exact Subalgebra.algebraMap_mem _ r
  | ι m =>
    rw [← Finset.univ_sum_single m, map_sum]
    refine Subalgebra.sum_mem _ fun a _ => ?_
    have : Pi.single a (m a) = m a • ev a := by
      rw [ev, ← Pi.single_smul, smul_eq_mul, mul_one]
    rw [this, map_smul]
    exact Subalgebra.smul_mem _ (ψ_mem_NX (Set.mem_univ a.1)) _
  | mul a b ha hb => exact mul_mem ha hb
  | add a b ha hb => exact add_mem ha hb

theorem incl_mem_NZ (X : Set Λ) (F : Grassmann.N Λ) : incl F ∈ NZ X := by
  refine Step.algHom_mem_of_mem_NX (X := Set.univ) _ (fun a _ => ?_) (mem_NX_univ F)
  rw [incl_psi]
  exact ψ_mem_NX (Or.inl ⟨a.1, rfl⟩)

end Doubled

end

end Step2
